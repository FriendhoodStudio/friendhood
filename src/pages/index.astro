---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import SectionFeature from '../components/SectionFeature.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import LogoCarousel from '../components/LogoCarousel.astro';
import LinkCards from '../components/LinkCards.astro';
import type { ProjectCardData } from '../types/project';
import { fetchFeaturedProjects } from '../lib/sanity/queries';

const projects: ProjectCardData[] = await fetchFeaturedProjects();
---

<Layout title="Friendhood">
  <Hero />
  <Services />
  <SectionFeature />
  <ProjectGallery projects={projects} showCaption={false} />
  <LogoCarousel />
  <LinkCards />
</Layout>

<style is:global>
  /* Services also renders on About, straight after a different section
     there with its own already-tuned gap — so its default pt-vertical-xl
     stays untouched globally. Scoped to only when it directly follows Hero
     (Home only): Hero now has its own pb-vertical-m (see the comment there)
     so its dark backdrop no longer ends flush with the showreel card, and
     this reduces Services' side of the gap by the same amount so the two
     combined don't add up to more than the original vertical-xl. */
  /* General sibling (~), not adjacent (+): Hero also renders its reel
     overlay as a sibling right after its own closing tag, so Services
     isn't literally adjacent to it in the DOM. */
  [data-hero-section] ~ [data-reveal-group='services'] {
    padding-top: calc(var(--spacing-vertical-xl) - var(--spacing-vertical-m));
  }
</style>
