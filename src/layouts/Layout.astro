---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import BackSoon from '../components/BackSoon.astro';

interface Props {
  title?: string;
  /** ~150-160 chars ideally — shown in search results and link previews. */
  description?: string;
  /** Absolute or root-relative URL for social share previews (og:image/twitter:image). Omitted entirely when not set, rather than falling back to something generic like the favicon. */
  image?: string;
  /** For pages that should never be indexed regardless of the SITE_LOCKED gate — e.g. the 404 page. */
  noindex?: boolean;
}

const {
  title = 'Friendhood',
  description = 'Friendhood — a creative consultancy for people thinking about tomorrow.',
  image,
  noindex = false,
} = Astro.props;

// Site-wide gate: set SITE_LOCKED=true only on the Production environment
// (host's project settings, not this file) to show "Back soon" on the real
// domain while every other page still routes through this same Layout —
// so nav/footer links to Work/About can't be used to route around it.
// Leave it unset on Preview deployments so those still render the full
// site for internal review/sharing. Flip it off in Production once ready
// to launch.
const isLocked = import.meta.env.SITE_LOCKED === 'true';

// Astro.site comes from the `site` config in astro.config.mjs — used to
// build absolute canonical/OG URLs regardless of what domain actually
// served this request (preview deployments, localhost, etc).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {(isLocked || noindex) && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content="Friendhood" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}

    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
  </head>
  <body class="bg-back">
    <NavBar />
    {isLocked ? <BackSoon /> : <slot />}
    <Footer />
  </body>
</html>
