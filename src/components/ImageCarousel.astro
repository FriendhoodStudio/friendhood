---
import type { CarouselImageItem } from '../types/carousel';

interface Props {
  images: CarouselImageItem[];
  /** Only case-study pages mount a <Lightbox /> to catch these images'
   * clicks — the About page's own intro carousel uses this same component
   * but has no lightbox on the page, so a zoom-in cursor there was a
   * dead-end affordance implying a click would do something when it never
   * did. Defaults to true so every existing case-study usage is unaffected;
   * About.astro is the one place that opts out. */
  zoomable?: boolean;
}

const { images, zoomable = true } = Astro.props;
---

{images.length > 0 && (
  <div class="flex w-full flex-col items-start gap-vertical-s">
    <div class="carousel-row full-bleed-scroll flex w-full items-start gap-gutter" data-image-carousel>
      {images.map((item) => (
        <div
          class="carousel-image reveal-item shrink-0 overflow-hidden rounded-card"
          data-wide={item.wide ? 'true' : 'false'}
        >
          <img
            src={item.url}
            alt={item.alt}
            class:list={['h-full w-full object-cover', { 'cursor-zoom-in': zoomable }]}
            loading="lazy"
            data-lightbox-image={zoomable ? true : undefined}
          />
        </div>
      ))}
    </div>

    {/* Only meaningful with more than one image — with just one there's
        nothing to page between. Same roundel treatment as the reel modal's
        close button and the services card's copy-email button (52px
        circle, border-front/15, bg-grey-600, backdrop-blur) — the
        small-round-icon-button idiom used everywhere else on the site —
        with the matching deep-overshoot press/release (see script).
        Auto-disable (see script) means these don't need their own "do we
        actually overflow" check — a row that already fits just renders
        both buttons permanently disabled. Deliberately NOT a .reveal-item:
        the scroll-reveal stagger is index-based within the group (see
        scrollReveal.ts), and this sits after every image in that order —
        giving it its own entry would make it visibly lag in well after the
        images instead of just being there with them, which reads as a
        delayed afterthought rather than part of the same block. */}
    {images.length > 1 && (
      <div class="flex items-center gap-horizontal-m" data-image-carousel-controls>
        <button
          type="button"
          class="carousel-btn flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-opacity duration-300 ease-out disabled:pointer-events-none disabled:opacity-40"
          data-image-carousel-prev
          aria-label="Previous image"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 2.5L4.5 9L11 15.5" stroke="#F3FAF0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <button
          type="button"
          class="carousel-btn flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-opacity duration-300 ease-out disabled:pointer-events-none disabled:opacity-40"
          data-image-carousel-next
          aria-label="Next image"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M7 2.5L13.5 9L7 15.5" stroke="#F3FAF0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    )}
  </div>
)}

<style>
  /*
   * Below desktop, images DON'T reshape or stack into a one-slide-at-a-time
   * carousel — they keep fixed pixel dimensions and simply overflow the
   * viewport, scrolling as a peeking row (originally matched directly
   * against Figma's About-page reference; generalised here to any number
   * of images rather than a fixed narrow+wide pair). Full-bleed break-out +
   * scroll-padding-inline scroll mechanics come from the shared
   * .full-bleed-scroll class (see global.css) — this block only has the
   * carousel-specific image sizing.
   *
   * Every image shares the SAME fixed height per tier (rather than each
   * having its own aspect ratio) — narrow/wide only differ by width.
   */
  .carousel-image {
    height: 425px;
  }
  .carousel-image[data-wide='false'] {
    width: 318px;
  }
  .carousel-image[data-wide='true'] {
    width: 360px;
  }
  @media (min-width: 768px) {
    .carousel-image {
      height: 465px;
    }
    .carousel-image[data-wide='false'] {
      width: var(--col-4);
    }
    .carousel-image[data-wide='true'] {
      width: var(--col-8);
    }
  }
  @media (min-width: 1200px) {
    /* Stays a genuine scrolling carousel at this tier too, rather than
       switching to a static stretch-to-fit pair — that only ever worked
       for exactly two images (a fixed-width narrow one and a wide one
       flex-filling whatever space was left), which doesn't generalise to
       an editor-controlled, unlimited-length list. Re-enables the scroll
       the shared .full-bleed-scroll class turns off at this tier (see
       global.css). Narrow images keep a fixed width (--col-4) with a 4:5
       ratio (matches the project card's own portrait ratio); wide images
       get a fixed width (--col-6) instead of flex-fill; both stretch to a
       shared row height via align-items: stretch + object-cover. */
    .carousel-row {
      overflow-x: auto;
      width: calc(100% + 2 * var(--page-margin));
      margin-inline: calc(-1 * var(--page-margin));
      padding-inline: var(--page-margin);
      scroll-padding-inline: var(--page-margin);
      align-items: stretch;
    }
    .carousel-image {
      height: auto;
    }
    .carousel-image[data-wide='false'] {
      width: var(--col-4);
      aspect-ratio: 4 / 5;
    }
    .carousel-image[data-wide='true'] {
      width: var(--col-6);
      min-width: 0;
    }
  }

  /* Press/release feel matching the nav pill, footer buttons, and the
     services card's copy-email button — quick firm press-in via this CSS
     transition, then a springy overshoot-past-rest on release driven by
     WAAPI (see script). Deep scale range (0.82→1.12→0.97→1) since these are
     small round icon buttons, same treatment as the reel modal's close
     button — not the nav pill's shallower press, which is tuned for a wide
     text pill instead. */
  .carousel-btn.is-pressed {
    transform: scale(0.82);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .carousel-btn.is-settling {
    transition: none;
  }
</style>

<script>
  // Reusable image carousel — every [data-image-carousel] instance on the
  // page (there could be more than one, this isn't scoped to a single
  // usage) gets its own independent prev/next controls and disabled-state
  // tracking.
  document.querySelectorAll<HTMLElement>('[data-image-carousel]').forEach((row) => {
    const controls = row.parentElement?.querySelector<HTMLElement>('[data-image-carousel-controls]');
    const prevBtn = controls?.querySelector<HTMLButtonElement>('[data-image-carousel-prev]');
    const nextBtn = controls?.querySelector<HTMLButtonElement>('[data-image-carousel-next]');
    if (!prevBtn || !nextBtn) return;

    function step() {
      // The first image's own width plus the row's current gutter — reads
      // the actual layout rather than a guessed constant, so it stays
      // correct across every breakpoint's different column/gutter tokens,
      // and regardless of how many images or which sizes are in the row.
      const first = row.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(row).columnGap || '0');
      return (first?.getBoundingClientRect().width ?? row.clientWidth) + gap;
    }

    function updateDisabled() {
      const maxScroll = row.scrollWidth - row.clientWidth;
      prevBtn!.disabled = row.scrollLeft <= 1;
      nextBtn!.disabled = row.scrollLeft >= maxScroll - 1;
    }

    prevBtn.addEventListener('click', () => {
      row.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      row.scrollBy({ left: step(), behavior: 'smooth' });
    });

    row.addEventListener('scroll', updateDisabled, { passive: true });
    window.addEventListener('resize', updateDisabled);
    updateDisabled();

    // Press/release overshoot, same as the nav pill and every other button
    // on the site — quick firm press-in via the CSS transition on
    // .is-pressed, then a springy overshoot-past-rest on release driven by
    // WAAPI so it can go past scale(1) before settling.
    [prevBtn, nextBtn].forEach((btn) => {
      let settleAnim: Animation | null = null;

      btn.addEventListener('pointerdown', () => {
        settleAnim?.cancel();
        btn.classList.remove('is-settling');
        btn.classList.add('is-pressed');
      });

      const releasePress = () => {
        if (!btn.classList.contains('is-pressed')) return;
        settleAnim = btn.animate(
          [
            { transform: 'scale(0.82)' },
            { transform: 'scale(1.12)', offset: 0.55 },
            { transform: 'scale(0.97)', offset: 0.8 },
            { transform: 'scale(1)' },
          ],
          { duration: 380, easing: 'ease-out', fill: 'forwards' }
        );
        btn.classList.add('is-settling');
        btn.classList.remove('is-pressed');

        const anim = settleAnim;
        anim.finished
          .then(() => {
            anim.cancel();
            btn.classList.remove('is-settling');
          })
          .catch(() => {});
      };

      btn.addEventListener('pointerup', releasePress);
      btn.addEventListener('pointerleave', releasePress);
      btn.addEventListener('pointercancel', releasePress);
    });
  });
</script>
