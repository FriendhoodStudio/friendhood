---
import type { ServiceItem } from '../types/services';
import ModuleTag from './ModuleTag.astro';
import emailIcon from '../assets/services/email-icon.svg';

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
---

<div
  data-services-overlay
  data-open="false"
  class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center bg-back/50 opacity-0 backdrop-blur-[25px] transition-opacity duration-400 ease-in-out data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
>
  {/* Position is now 100% native — a real overflow-x:auto strip with
      scroll-snap-type:x mandatory, not a JS-owned "offset" fighting or
      replacing the browser's own scroll. A previous version tried both a
      hand-rolled transform-position engine AND, before that, native scroll
      fought by JS on top of it — every input path (touch, trackpad, mouse
      drag, wheel) needed its own from-scratch reimplementation of
      gesture-start/move/end, momentum, and snap, and real devices kept
      surfacing timing/capture edge cases no amount of patching fully
      closed. Handing position and momentum back to the browser removes
      that whole category outright: touch/trackpad scrolling and
      snap-to-nearest-card are native and free. touch-action: pan-x still
      lets native horizontal panning through but leaves the vertical axis
      free for our own swipe-to-close JS (see script) — the standard way to
      combine a native scroll axis with a custom gesture on the other one.
      No infinite loop for now (cards simply clamp at both ends) — that's
      a deliberate, disclosed scope cut while the core interaction proves
      itself; the classic scroll-snap way to add it back later is cloning
      a card at each end, not reintroducing a JS-owned position. */}
  <div
    data-services-track
    class="flex w-full snap-x snap-mandatory gap-[var(--spacing-gutter)] overflow-x-auto"
    style="touch-action: pan-x; scrollbar-width: none; user-select: none;"
  >
    {services.map((service, i) => (
      <div
        class="services-card flex shrink-0 snap-center flex-col items-center gap-[10px] overflow-hidden rounded-card bg-accent-yellow/90 pb-[75px] shadow-[0_0_4px_rgba(0,0,0,0.3)] backdrop-blur-[25px]"
        data-service-card
        data-index={i}
        data-name={service.name}
      >
        <div class="flex w-full flex-col items-start gap-[20px]">
          <div class="relative aspect-square w-full overflow-hidden">
            {/* Eager, not lazy — this carousel is hidden until opened, so
                lazy-loading buys nothing on initial page load. */}
            <img src={service.imageUrl} alt="" class="h-full w-full object-cover" loading="eager" />
            {/* Gradiating darkness + blur behind the two controls below —
                a plain flat scrim would read as a hard-edged box sitting on
                the photo; fading both the tint and the blur strength itself
                (via mask-image, not just the tint) reads as a soft vignette
                instead, regardless of what the image underneath is doing.
                pointer-events-none: purely visual, must not sit in front of
                the controls it's there to support. */}
            <div class="services-card-top-fade pointer-events-none absolute inset-x-0 top-0 h-[110px]" aria-hidden="true"></div>
            {/* Was a plain bar sitting in its own yellow strip above the
                image; now the image runs flush to the card's own top edge
                (no more strip), so this moved onto the photo itself as a
                floating pill — same backdrop-blur/border/bg-grey-600
                treatment as the copy-email button just below it, so it
                stays legible over whatever the image happens to be. */}
            {/* No background chip — just the bar itself, wide enough to be
                an easy target on its own without needing one. Hover/press
                feedback lives on the bar's own opacity instead of a
                background, since there's no longer a background to react. */}
            <button
              type="button"
              class="services-drag-handle group absolute left-1/2 top-[14px] flex h-[26px] w-[100px] -translate-x-1/2 cursor-pointer items-center justify-center transition-transform duration-300 ease-in-out hover:scale-110 active:scale-90"
              data-services-close
              aria-label="Close"
            >
              <span class="h-1 w-[56px] rounded-full bg-front/70 transition-colors duration-300 ease-out group-hover:bg-front"></span>
            </button>
            {/* pointer-events-none: this wrapper is inset-x-0 (full card
                width) so its empty left side doesn't have anything painted
                in it — but as a plain positioned div it was still capturing
                pointer events across that whole invisible area, sitting in
                front of (later in DOM order than) the close button above
                and silently eating its clicks/hover. Only the actual
                button inside needs to opt back in with pointer-events-auto. */}
            <div class="pointer-events-none absolute inset-x-0 top-0 flex items-start justify-end px-[15px] pt-[10px]">
              <div class="group relative">
                <button
                  type="button"
                  class="copy-email-btn pointer-events-auto flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110"
                  data-copy-email
                  data-email="hello@friendhood.co.uk"
                  aria-label="Copy email address"
                >
                  <img
                    src={emailIcon.src}
                    alt=""
                    class="h-full w-full transition-opacity duration-300 ease-out group-hover:opacity-90 group-active:opacity-70"
                  />
                </button>
                <span
                  data-copy-email-status
                  class="pointer-events-none absolute right-0 top-full mt-2 whitespace-nowrap rounded-m border border-front/15 bg-grey-600 px-3 py-1 opacity-0 backdrop-blur-[14px] transition-opacity duration-300 ease-out group-hover:opacity-100"
                >
                  <span class="relative block h-[18px] overflow-hidden">
                    {/* leading-[18px] (not leading-none) — same fix as the
                        nav Menu/Close toggle's own h-[21px] window: height
                        alone doesn't vertically centre a single line of
                        text in a taller box, it just leaves the extra
                        space at the bottom. */}
                    <span
                      data-copy-email-status-track
                      class="flex flex-col font-tag text-detail leading-[18px] text-front transition-transform duration-400 ease-in-out"
                    >
                      <span class="block h-[18px]">Enquire now</span>
                      <span data-copy-email-status-result class="block h-[18px]"></span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
          </div>
          {/* Dividers between title/overview/modules are gone — per the
              latest Figma pass (node 7382:2286), this now reads as one
              continuous block with title→overview at 20px and
              overview→modules at 36px, rather than ruled-off sections. */}
          <div class="services-card-text flex w-full flex-col items-start gap-[20px]">
            <h3 class="font-heading text-h3 text-back">{service.cardTitle}</h3>
            <div class="flex w-full flex-col items-start gap-[36px]">
              <p class="font-tag text-detail text-back">{service.overview}</p>
              <div class="flex w-full flex-col items-start gap-[10px]">
                <p class="font-tag text-categories text-[#5c5c5c]">Example Modules</p>
                <div class="flex flex-wrap gap-1">
                  {service.modules.map((moduleName) => <ModuleTag label={moduleName} />)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Card height is no longer pinned here at all — with normal (non-
     absolute) flex-row children, the track's own cross-size just follows
     its tallest child automatically, so there's nothing to keep in sync by
     hand any more. Only the shared width var lives on the track now,
     inherited down to .services-card below. scroll-padding-inline mirrors
     the track's own inline padding — both have to agree, since that pair
     is what lets the FIRST and LAST cards also reach dead centre (without
     it, scroll-snap can only centre a card once there's already a full
     half-track's worth of empty space to scroll into on that side). Hiding
     the scrollbar is purely cosmetic — the peeking cards themselves are
     the scroll affordance, a visible scrollbar under the overlay would
     just be visual noise. */
  [data-services-track] {
    --services-card-image-size: min(446px, 72vw);
    padding-inline: calc((100% - var(--services-card-image-size)) / 2);
    scroll-padding-inline: calc((100% - var(--services-card-image-size)) / 2);
  }
  [data-services-track]::-webkit-scrollbar {
    display: none;
  }

  /* Tablet gets its own tier, narrower than the mobile 446px cap — that cap
     is tuned for phone widths (72vw stops mattering and 446px takes over
     well before real tablet widths), so every tablet size was rendering the
     same flat 446px with almost no peek either side (confirmed at 816px
     wide: card filled the viewport bar ~100px per side). 400px restores a
     clearer peek without going as narrow as desktop, which has much more
     spare width to work with. */
  @media (min-width: 768px) {
    [data-services-track] {
      --services-card-image-size: 400px;
    }
  }

  /* Narrower still at desktop — matches the same 1200px threshold the rest
     of the site's "L" tier switches on. Height/content padding are
     untouched, so this only tightens the measure of the title/overview
     text, not how much of it fits. */
  @media (min-width: 1200px) {
    [data-services-track] {
      --services-card-image-size: 380px;
    }
  }

  .services-card {
    width: var(--services-card-image-size);
    cursor: grab;
  }
  .services-card:active {
    cursor: grabbing;
  }

  /* Doubled on mobile specifically (20px vs the 10px the *1.25 formula
     alone would give at this tier) — read as too tight at real mobile
     widths even though the same formula reads fine from 768px up, so this
     overrides just the base tier rather than changing the shared formula
     everywhere. */
  .services-card-text {
    padding-inline: calc(var(--spacing-horizontal-m) * 2.5);
  }
  @media (min-width: 768px) {
    .services-card-text {
      padding-inline: calc(var(--spacing-horizontal-m) * 1.25);
    }
  }

  /* Sits behind the close handle and copy-email button, giving them a
     legible backdrop against whatever the photo underneath is doing —
     needed once the close handle lost its own background chip. Two
     separate fades stacked on the same element, both anchored at the top
     and softening to nothing by the same point, so neither reads as a hard
     edge: the tint via the gradient's own alpha stops, and the blur
     STRENGTH itself via mask-image (backdrop-filter has no way to vary its
     own intensity across an element — masking the element that carries it
     is the actual technique for a "graduating blur" rather than a blurred
     rectangle with a sharp cutoff). */
  .services-card-top-fade {
    background: linear-gradient(to bottom, rgba(13, 13, 13, 0.45), rgba(13, 13, 13, 0) 100%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to bottom, black, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 100%);
  }

  /* Press/release feel for the copy-email button, matching the nav pill's
     quick-firm-press + springy-overshoot-release — scale-based here rather
     than the pill's 3D tilt, since this is a small round icon button, not
     a wide shape a see-saw motion would read on. Release is driven by
     WAAPI (see script) so it can overshoot past 1 before settling; this
     transition is only what plays while actually held down. */
  .copy-email-btn.is-pressed {
    transform: scale(0.82);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .copy-email-btn.is-settling {
    transition: none;
  }
</style>

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../lib/scrollLock';

  const overlay = document.querySelector<HTMLElement>('[data-services-overlay]');
  const track = document.querySelector<HTMLElement>('[data-services-track]');
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>('[data-service-card]')) : [];
  const N = cards.length;

  let copyButtons: HTMLButtonElement[] = [];

  function isOpen() {
    return overlay?.dataset.open === 'true';
  }

  function setOpen(next: boolean) {
    if (!overlay) return;
    overlay.dataset.open = String(next);
    overlay.toggleAttribute('inert', !next);
    if (next) lockBodyScroll();
    else unlockBodyScroll();
  }

  // --- Position & visual state ---------------------------------------------
  //
  // Actual position is just `track.scrollLeft` now — native, browser-owned,
  // never shadowed by a parallel JS number. Everything below only ever
  // READS scroll position to drive the purely-visual scale/fade of peeking
  // cards; nothing here writes position directly except the one-time
  // instant jump in openAt (equivalent to an un-animated scrollIntoView).
  //
  // step()/cardCenter() use offsetWidth/offsetLeft (the element's LAYOUT
  // box), not getBoundingClientRect (its PAINTED box) — peeking cards carry
  // a scale() transform for the fade effect below, which changes their
  // painted rect but never their layout box or offsetLeft. Reading layout
  // values means this stays correct however a card is currently scaled.
  function step(): number {
    if (!track || !cards[0]) return 0;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    return cards[0].offsetWidth + gap;
  }

  function cardDelta(card: HTMLElement): number {
    if (!track) return 0;
    const s = step();
    if (!s) return 0;
    const cardCenter = card.offsetLeft + card.offsetWidth / 2;
    const trackCenter = track.scrollLeft + track.clientWidth / 2;
    return (cardCenter - trackCenter) / s;
  }

  // Whichever card currently sits closest to the track's visual centre —
  // the native-scroll equivalent of the old JS-owned targetOffset, just
  // always re-derived from the real scroll position instead of tracked
  // separately, since there's no seam any more for the two to disagree
  // across.
  function nearestIndex(): number {
    let best = 0;
    let bestDist = Infinity;
    cards.forEach((card, i) => {
      const d = Math.abs(cardDelta(card));
      if (d < bestDist) {
        bestDist = d;
        best = i;
      }
    });
    return best;
  }

  // Scale/fade cards by distance from centre — the closer to centre, the
  // larger and more opaque, per the Figma annotation calling for "the rest
  // smaller and faded". One full step away (a peeking neighbour) is where
  // this bottoms out at its floor; 0.55 opacity / 0.85 scale keeps that
  // peeking card reading as "the next card" rather than washing out into
  // background blur.
  function cardVisualState(delta: number) {
    const t = Math.min(Math.abs(delta), 1);
    return { scale: 1 - t * 0.15, opacity: 1 - t * 0.45 };
  }

  function updateVisualState() {
    cards.forEach((card) => {
      const { scale, opacity } = cardVisualState(cardDelta(card));
      card.style.transform = `scale(${scale})`;
      card.style.opacity = String(opacity);
    });
  }

  // rAF-throttled for the scroll listener — scroll can fire far faster than
  // the screen repaints, and writing transform/opacity on every raw event
  // is the same jank source a raw pointermove listener would be.
  let visualRafId = 0;
  function scheduleVisualUpdate() {
    if (visualRafId) return;
    visualRafId = requestAnimationFrame(() => {
      visualRafId = 0;
      updateVisualState();
    });
  }

  track?.addEventListener('scroll', scheduleVisualUpdate, { passive: true });
  updateVisualState();

  // Per the Figma annotation, the carousel "emerges from bottom of page" — driven
  // via WAAPI (not a CSS transition) so it can play per-card, staggered from the
  // centered card outward, and the exact reverse (outward in first, center last)
  // on close. Each card animates its own translateY entrance while holding its
  // cardVisualState scale/opacity as the end value, so it settles exactly where
  // updateVisualState would have put it — no fighting between the two.
  const SLIDE_DISTANCE = 120;
  const STAGGER_MS = 80;
  const STAGGER_RANGE = 2; // cards more than this far from center share the outermost delay

  function playOpenAnimation() {
    cards.forEach((card) => {
      card.getAnimations().forEach((anim) => anim.cancel());
      // Same stale-hit-test-after-cancel concern as below, but for a leftover
      // animation from a previous open/close cycle (e.g. a close animation
      // still in its pre-start delay when the carousel is reopened) — flush
      // right away rather than only after this new animation's own finish.
      void card.offsetWidth;
      const delta = cardDelta(card);
      const { scale, opacity } = cardVisualState(delta);
      const distance = Math.min(Math.abs(delta), STAGGER_RANGE);
      const anim = card.animate(
        [
          { transform: `scale(${scale}) translateY(${SLIDE_DISTANCE}px)`, opacity: 0 },
          { transform: `scale(${scale}) translateY(0)`, opacity },
        ],
        {
          duration: 600,
          delay: distance * STAGGER_MS,
          easing: 'cubic-bezier(0.22, 1.36, 0.36, 1)',
          fill: 'forwards',
        }
      );
      // Release the animation once it settles so its fill:forwards effect stops
      // pinning transform/opacity — otherwise it permanently overrides
      // updateVisualState as the user scrolls afterward, and the centered
      // card stops rescaling.
      anim.finished
        .then(() => {
          anim.cancel();
          // Chromium can leave a stale compositor hit-test region behind for a
          // card right after a WAAPI animation on it is cancelled — the paint
          // is correct (and elementFromPoint agrees), but real pointer input
          // can still resolve to the old hit-test rect for a bit, so clicks on
          // e.g. the copy-email button land on the track underneath instead.
          // Forcing a synchronous layout read flushes that stale state.
          void card.offsetWidth;
        })
        .catch(() => {});
    });
  }

  function playCloseAnimation() {
    cards.forEach((card) => {
      card.getAnimations().forEach((anim) => anim.cancel());
      void card.offsetWidth;
      const delta = cardDelta(card);
      const { scale, opacity } = cardVisualState(delta);
      const distance = Math.min(Math.abs(delta), STAGGER_RANGE);
      // Reverse of the open stagger: farthest-from-center cards leave first,
      // the centered card leaves last.
      const delay = (STAGGER_RANGE - distance) * STAGGER_MS;
      card.animate(
        [
          { transform: `scale(${scale}) translateY(0)`, opacity, offset: 0 },
          { transform: `scale(${scale}) translateY(${SLIDE_DISTANCE}px)`, opacity, offset: 0.55 },
          { transform: `scale(${scale}) translateY(${SLIDE_DISTANCE}px)`, opacity: 0, offset: 1 },
        ],
        { duration: 700, delay, easing: 'ease-in', fill: 'forwards' }
      );
    });
  }

  // The just-opened card is still settling into its centered position for a
  // brief moment after openAt() returns — real (trusted) clicks landing in
  // this window have been observed to occasionally hit the track underneath
  // a button instead of the button itself, which the backdrop-click-to-close
  // handler below would otherwise read as "clicked outside a card" and close
  // on. Ignoring backdrop-close clicks for a short settle window after
  // opening means a mistimed click is just a no-op instead of spuriously
  // closing the carousel.
  const OPEN_SETTLE_MS = 400;
  let openedAt = 0;

  function openAt(index: number) {
    setOpen(true);
    openedAt = performance.now();
    const card = cards[index];
    if (track && card) {
      // Instant jump, not scrollIntoView({behavior:'smooth'}) — this is the
      // resting position the entrance animation plays FROM, so it must
      // already be correct before that animation starts, not visibly
      // travel there first.
      track.scrollLeft = card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2;
    }
    updateVisualState();
    playOpenAnimation();
  }

  function close() {
    playCloseAnimation();
    setOpen(false);
  }

  document.querySelectorAll<HTMLElement>('[data-service-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const index = Number(trigger.dataset.index) || 0;
      openAt(index);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-services-close]').forEach((btn) => {
    btn.addEventListener('click', close);
  });

  // Clicking anywhere that isn't a card (the overlay backdrop, or the track's own
  // padding/gap areas around the cards) closes the carousel.
  //
  // setPointerCapture only reroutes POINTER events, not the separate legacy
  // mouse event stream 'click' belongs to — so a mouse-drag-to-scroll (see
  // below) that starts on a card but ends over the gap between cards (a
  // very ordinary drag distance) still gets a real 'click' synthesized on
  // the gap/backdrop at mouseup, same as a real click would. Recording the
  // pointerdown position and bailing here if the eventual click is more
  // than a few px away from it is what actually distinguishes "a drag that
  // happened to end outside a card" from "a genuine tap/click on the
  // backdrop to dismiss" — closest()-on-target alone can't tell those apart.
  let backdropPointerDownPos: { x: number; y: number } | null = null;
  overlay?.addEventListener('pointerdown', (e) => {
    backdropPointerDownPos = { x: e.clientX, y: e.clientY };
  });
  overlay?.addEventListener('click', (e) => {
    if (performance.now() - openedAt < OPEN_SETTLE_MS) return;
    if (backdropPointerDownPos) {
      const dx = e.clientX - backdropPointerDownPos.x;
      const dy = e.clientY - backdropPointerDownPos.y;
      if (Math.hypot(dx, dy) > 8) return;
    }
    const target = e.target as HTMLElement;
    if (target.closest('[data-service-card]')) return;
    close();
  });

  // Clamped at both ends for now — no wraparound (see the top-of-file note
  // on the dropped infinite loop).
  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const next = nearestIndex() + (e.key === 'ArrowRight' ? 1 : -1);
    if (next < 0 || next >= N) return;
    cards[next].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  });

  // Clicking a peeking (not-yet-centered) card brings it to centre. Same
  // drag-vs-click distinction as the backdrop-close handler above (and the
  // same reason it's needed): a mouse-drag-to-scroll that starts on one
  // card can easily end over a NEIGHBOURING card, which still gets a real
  // 'click' at mouseup — without the movement guard that would also
  // trigger a click-to-jump on top of the drag's own native scroll,
  // fighting it. The close/copy-email buttons opt out since they already
  // have their own click behaviour.
  track?.addEventListener('click', (e) => {
    if (backdropPointerDownPos && Math.hypot(e.clientX - backdropPointerDownPos.x, e.clientY - backdropPointerDownPos.y) > 8) {
      return;
    }
    const target = e.target as HTMLElement;
    if (target.closest('[data-services-close]') || target.closest('[data-copy-email]')) return;
    const card = target.closest<HTMLElement>('[data-service-card]');
    if (!card || cards.indexOf(card) === nearestIndex()) return;
    card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  });

  function isMobileOrTablet() {
    return window.innerWidth < 1200;
  }

  // Distinct from close() (used by the pill button/Escape/backdrop click):
  // that path always animates cards from a resting translateY(0), which
  // would visibly snap the dragged card back to 0 before playing — jarring
  // right after a swipe that's already partway through that same motion.
  // This continues the drag's own motion off-screen instead of restarting it.
  function closeViaSwipe(card: HTMLElement, fromY: number, scale: number) {
    setOpen(false);
    cards.forEach((c) => {
      if (c === card) return;
      c.getAnimations().forEach((a) => a.cancel());
      c.animate([{ opacity: getComputedStyle(c).opacity }, { opacity: 0 }], {
        duration: 250,
        easing: 'ease-out',
        fill: 'forwards',
      });
    });
    card.getAnimations().forEach((a) => a.cancel());
    const anim = card.animate(
      [
        { transform: `scale(${scale}) translateY(${fromY}px)`, opacity: getComputedStyle(card).opacity },
        { transform: `scale(${scale}) translateY(${fromY + SLIDE_DISTANCE}px)`, opacity: 0 },
      ],
      { duration: 350, easing: 'ease-in', fill: 'forwards' }
    );
    anim.finished.then(() => anim.cancel()).catch(() => {});
  }

  // Swipe-down-to-close, mobile/tablet only (below the desktop breakpoint) —
  // a standard bottom-sheet dismiss gesture. touch-action: pan-x (see the
  // track's markup) already keeps native horizontal panning/scrolling free
  // to run on its own — this only ever has to recognise and act on the
  // VERTICAL case; a horizontal-dominant touch is simply abandoned here
  // (swipePointerId reset to null) and left entirely to native scroll,
  // which is already moving by the time that happens.
  const SWIPE_CLOSE_THRESHOLD_PX = 100;
  const SWIPE_CLOSE_VELOCITY_PX_MS = 0.5;

  let swipeCard: HTMLElement | null = null;
  let swipeScale = 1;
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeStartTime = 0;
  let swipeDeltaY = 0;
  let swipeActive = false;
  let swipePointerId: number | null = null;

  track?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'touch' || !isMobileOrTablet()) return;
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-service-card]');
    if (!card) return; // nothing to animate a dismiss on — leave entirely to native scroll
    swipeCard = card;
    swipeScale = cardVisualState(cardDelta(card)).scale;
    swipeStartX = e.clientX;
    swipeStartY = e.clientY;
    swipeStartTime = e.timeStamp;
    swipeDeltaY = 0;
    swipeActive = false;
    swipePointerId = e.pointerId;
  });

  track?.addEventListener('pointermove', (e) => {
    if (swipePointerId === null || e.pointerId !== swipePointerId || !swipeCard) return;
    const dx = e.clientX - swipeStartX;
    const dy = e.clientY - swipeStartY;

    if (!swipeActive) {
      // Wait for enough movement to confidently read the gesture's
      // direction — locking on the first pixel of jitter would misclassify
      // real horizontal swipes.
      if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
      if (Math.abs(dy) <= Math.abs(dx)) {
        // Horizontal — hand off entirely to native scroll.
        swipePointerId = null;
        swipeCard = null;
        return;
      }
      swipeActive = true;
      swipeCard.setPointerCapture(swipePointerId);
    }

    e.preventDefault();
    swipeDeltaY = Math.max(0, dy); // downward only — an upward drag is a no-op
    swipeCard.style.transform = `scale(${swipeScale}) translateY(${swipeDeltaY}px)`;
    swipeCard.style.opacity = String(Math.max(0.4, 1 - swipeDeltaY / 400));
  });

  function endSwipe(e: PointerEvent) {
    if (swipePointerId === null || e.pointerId !== swipePointerId || !swipeCard) return;
    const card = swipeCard;
    const wasActive = swipeActive;
    const endedPointerId = swipePointerId;
    swipeCard = null;
    swipeActive = false;
    swipePointerId = null;
    if (!wasActive) return;
    try {
      card.releasePointerCapture(endedPointerId);
    } catch {
      // Already released/invalid — nothing to clean up.
    }

    const elapsed = e.timeStamp - swipeStartTime;
    const velocity = swipeDeltaY / Math.max(elapsed, 1);
    if (swipeDeltaY > SWIPE_CLOSE_THRESHOLD_PX || velocity > SWIPE_CLOSE_VELOCITY_PX_MS) {
      closeViaSwipe(card, swipeDeltaY, swipeScale);
    } else {
      // Under threshold — spring back, same overshoot-and-settle language
      // as every other press/release interaction on the site.
      card.getAnimations().forEach((a) => a.cancel());
      const settle = card.animate(
        [
          { transform: `scale(${swipeScale}) translateY(${swipeDeltaY}px)`, opacity: card.style.opacity },
          { transform: `scale(${swipeScale}) translateY(-8px)`, opacity: 1, offset: 0.7 },
          { transform: `scale(${swipeScale}) translateY(0)`, opacity: 1 },
        ],
        { duration: 380, easing: 'ease-out', fill: 'forwards' }
      );
      settle.finished
        .then(() => {
          settle.cancel();
          // No CSS default for this card to fall back to once the inline
          // style is cleared — re-assert its normal resting scale/opacity
          // instead of clearing it to nothing.
          updateVisualState();
        })
        .catch(() => {});
    }
  }

  track?.addEventListener('pointerup', endSwipe);
  track?.addEventListener('pointercancel', endSwipe);

  // Click-and-drag-to-scroll for plain-mouse desktop users (a trackpad's
  // two-finger swipe already scrolls the track natively via wheel deltaX —
  // this is only for a mouse with no trackpad). Directly drives scrollLeft;
  // native scroll-snap takes over and animates to the nearest card the
  // instant the gesture ends, the same as it does after any other scroll —
  // no custom tween needed here.
  let mouseDragging = false;
  let mouseDragStartX = 0;
  let mouseDragStartScrollLeft = 0;
  let mouseMoveRafId = 0;
  let pendingMouseClientX = 0;

  track?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || !track) return;
    mouseDragging = true;
    mouseDragStartX = e.clientX;
    mouseDragStartScrollLeft = track.scrollLeft;
  });

  track?.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || !mouseDragging || !track) return;
    pendingMouseClientX = e.clientX;
    if (mouseMoveRafId) return;
    mouseMoveRafId = requestAnimationFrame(() => {
      mouseMoveRafId = 0;
      if (!mouseDragging || !track) return;
      track.scrollLeft = mouseDragStartScrollLeft - (pendingMouseClientX - mouseDragStartX);
    });
  });

  function endMouseDrag(e: PointerEvent) {
    if (e.pointerType !== 'mouse') return;
    mouseDragging = false;
  }

  track?.addEventListener('pointerup', endMouseDrag);
  track?.addEventListener('pointercancel', endMouseDrag);
  track?.addEventListener('pointerleave', endMouseDrag);

  copyButtons = overlay ? Array.from(overlay.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) : [];
  copyButtons.forEach((copyButton) => {
    const status = copyButton.parentElement?.querySelector<HTMLElement>('[data-copy-email-status]');
    const track = status?.querySelector<HTMLElement>('[data-copy-email-status-track]');
    const result = status?.querySelector<HTMLElement>('[data-copy-email-status-result]');
    let hideTimeout = 0;

    // Same two-row roll used for the nav's Menu/Close toggle: a fixed-height
    // window with both labels stacked in a flex column, translated up by
    // half its own height to swap which row shows. The tooltip element also
    // doubles as the hover label ("Enquire now", shown via CSS group-hover)
    // — the inline opacity set here temporarily overrides that, then clears
    // afterward so it falls back to plain CSS hover behavior once the
    // click-feedback window ends, rather than getting stuck.
    function showStatus(text: string) {
      if (!status || !track || !result) return;
      window.clearTimeout(hideTimeout);
      result.textContent = text;
      status.style.opacity = '1';
      track.classList.add('-translate-y-1/2');
      hideTimeout = window.setTimeout(() => {
        status.style.opacity = '';
        track.classList.remove('-translate-y-1/2');
      }, 1500);
    }

    // Press/release: same quick-firm-press-in then springy-overshoot-release
    // as the nav pill, scale-based instead of the pill's 3D tilt.
    let settleAnim: Animation | null = null;

    copyButton.addEventListener('pointerdown', () => {
      settleAnim?.cancel();
      copyButton.classList.remove('is-settling');
      copyButton.classList.add('is-pressed');
    });

    const releasePress = () => {
      if (!copyButton.classList.contains('is-pressed')) return;
      settleAnim = copyButton.animate(
        [
          { transform: 'scale(0.82)' },
          { transform: 'scale(1.12)', offset: 0.55 },
          { transform: 'scale(0.97)', offset: 0.8 },
          { transform: 'scale(1)' },
        ],
        { duration: 380, easing: 'ease-out', fill: 'forwards' }
      );
      copyButton.classList.add('is-settling');
      copyButton.classList.remove('is-pressed');

      const anim = settleAnim;
      anim.finished
        .then(() => {
          anim.cancel();
          copyButton.classList.remove('is-settling');
        })
        .catch(() => {});
    };

    copyButton.addEventListener('pointerup', releasePress);
    copyButton.addEventListener('pointerleave', releasePress);
    copyButton.addEventListener('pointercancel', releasePress);

    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        showStatus('Email copied');
      } catch (err) {
        // Surfaced instead of silently swallowed — a failure here (blocked
        // clipboard permission, insecure context, etc.) previously looked
        // identical to success: the button just did nothing either way.
        console.error('Copy email to clipboard failed:', err);
        showStatus("Couldn't copy — try again");
      }
    });
  });
</script>
