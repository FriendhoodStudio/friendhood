---
import type { ServiceItem } from '../types/services';
import ModuleTag from './ModuleTag.astro';
import emailIcon from '../assets/services/email-icon.svg';

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
---

<div
  data-services-overlay
  data-open="false"
  class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center bg-back/50 opacity-0 backdrop-blur-[25px] transition-opacity duration-400 ease-in-out data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
>
  {/* Every card is absolutely positioned and placed purely by JS (see the
      script's render()) via one continuous "offset" number — not a real
      scroll position. The previous version drove this by scrolling a real
      overflow-x:auto strip (with content repeated 5x to fake an infinite
      loop), with JS then fighting that native scroll for exact per-card
      control on top of it. Two systems sharing one position was the root
      of a whole run of bugs: touch drags fighting the browser's own
      native touch-scroll on the same element, a new drag racing a
      still-finishing native smooth-scroll from the previous one, "which
      card is current" going ambiguous mid-transition. A single JS-owned
      position removes the seam between them entirely — there's no native
      scroll left to disagree with, and no repeated DOM needed for the
      loop (see wrappedDelta in the script). touch-action: none keeps the
      browser's own touch gesture recognizer out of the way of the
      hand-rolled drag below (horizontal stepping and vertical
      swipe-to-close both live entirely in JS, same as before). */}
  <div data-services-track class="relative flex w-full gap-[var(--spacing-gutter)]" style="touch-action: none;">
    {services.map((service, i) => (
      <div
        class="services-card absolute left-1/2 top-1/2 flex flex-col items-center gap-[10px] overflow-hidden rounded-card bg-accent-yellow/90 pb-[75px] shadow-[0_0_4px_rgba(0,0,0,0.3)] backdrop-blur-[25px]"
        data-service-card
        data-index={i}
        data-name={service.name}
      >
        <div class="flex w-full flex-col items-start gap-[20px]">
          <div class="relative aspect-square w-full overflow-hidden">
            {/* Eager, not lazy — this carousel is hidden until opened, so
                lazy-loading buys nothing on initial page load. */}
            <img src={service.imageUrl} alt="" class="h-full w-full object-cover" loading="eager" />
            {/* Gradiating darkness + blur behind the two controls below —
                a plain flat scrim would read as a hard-edged box sitting on
                the photo; fading both the tint and the blur strength itself
                (via mask-image, not just the tint) reads as a soft vignette
                instead, regardless of what the image underneath is doing.
                pointer-events-none: purely visual, must not sit in front of
                the controls it's there to support. */}
            <div class="services-card-top-fade pointer-events-none absolute inset-x-0 top-0 h-[110px]" aria-hidden="true"></div>
            {/* Was a plain bar sitting in its own yellow strip above the
                image; now the image runs flush to the card's own top edge
                (no more strip), so this moved onto the photo itself as a
                floating pill — same backdrop-blur/border/bg-grey-600
                treatment as the copy-email button just below it, so it
                stays legible over whatever the image happens to be. */}
            {/* No background chip — just the bar itself, wide enough to be
                an easy target on its own without needing one. Hover/press
                feedback lives on the bar's own opacity instead of a
                background, since there's no longer a background to react. */}
            <button
              type="button"
              class="services-drag-handle group absolute left-1/2 top-[14px] flex h-[26px] w-[100px] -translate-x-1/2 cursor-pointer items-center justify-center transition-transform duration-300 ease-in-out hover:scale-110 active:scale-90"
              data-services-close
              aria-label="Close"
            >
              <span class="h-1 w-[56px] rounded-full bg-front/70 transition-colors duration-300 ease-out group-hover:bg-front"></span>
            </button>
            {/* pointer-events-none: this wrapper is inset-x-0 (full card
                width) so its empty left side doesn't have anything painted
                in it — but as a plain positioned div it was still capturing
                pointer events across that whole invisible area, sitting in
                front of (later in DOM order than) the close button above
                and silently eating its clicks/hover. Only the actual
                button inside needs to opt back in with pointer-events-auto. */}
            <div class="pointer-events-none absolute inset-x-0 top-0 flex items-start justify-end px-[15px] pt-[10px]">
              <div class="group relative">
                <button
                  type="button"
                  class="copy-email-btn pointer-events-auto flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110"
                  data-copy-email
                  data-email="hello@friendhood.co.uk"
                  aria-label="Copy email address"
                >
                  <img
                    src={emailIcon.src}
                    alt=""
                    class="h-full w-full transition-opacity duration-300 ease-out group-hover:opacity-90 group-active:opacity-70"
                  />
                </button>
                <span
                  data-copy-email-status
                  class="pointer-events-none absolute right-0 top-full mt-2 whitespace-nowrap rounded-m border border-front/15 bg-grey-600 px-3 py-1 opacity-0 backdrop-blur-[14px] transition-opacity duration-300 ease-out group-hover:opacity-100"
                >
                  <span class="relative block h-[18px] overflow-hidden">
                    {/* leading-[18px] (not leading-none) — same fix as the
                        nav Menu/Close toggle's own h-[21px] window: height
                        alone doesn't vertically centre a single line of
                        text in a taller box, it just leaves the extra
                        space at the bottom. */}
                    <span
                      data-copy-email-status-track
                      class="flex flex-col font-tag text-detail leading-[18px] text-front transition-transform duration-400 ease-in-out"
                    >
                      <span class="block h-[18px]">Enquire now</span>
                      <span data-copy-email-status-result class="block h-[18px]"></span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
          </div>
          {/* Dividers between title/overview/modules are gone — per the
              latest Figma pass (node 7382:2286), this now reads as one
              continuous block with title→overview at 20px and
              overview→modules at 36px, rather than ruled-off sections. */}
          <div class="services-card-text flex w-full flex-col items-start gap-[20px]">
            <h3 class="font-heading text-h3 text-back">{service.cardTitle}</h3>
            <div class="flex w-full flex-col items-start gap-[36px]">
              <p class="font-tag text-detail text-back">{service.overview}</p>
              <div class="flex w-full flex-col items-start gap-[10px]">
                <p class="font-tag text-categories text-[#5c5c5c]">Example Modules</p>
                <div class="flex flex-wrap gap-1">
                  {service.modules.map((moduleName) => <ModuleTag label={moduleName} />)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Height lives here (not just on .services-card) so the track — the
     containing block every card's left:50%/top:50% resolves against — is
     exactly as tall as a card, keeping top:50% landing on the real visual
     centre. Single source of truth for both via the custom property,
     inherited down to .services-card below rather than redeclared there.

     740 (matching Figma's own reference example — node 7382:2286 — which
     has 9 module tags across 3 rows) badly overshot every REAL service's
     actual content: measured directly, the tallest real card's content
     (tags included) bottoms out around 592px, not anywhere near Figma's
     reference length. That was 325px image + 267px of gap/text/tags below
     it — so 592 = 325 + 267, and the fixed height itself was that plus
     Figma's own 75px bottom padding and a small buffer: 670 = 592 + 75 + 3.

     The image is a square (see the aspect-square container in the markup
     above), so its height tracks the card's own width instead of a flat
     325px — meaning the height needed to stay snug against real content
     ALSO now tracks width: height = image size (= width, square) + that
     same fixed 267+75+3 = 345px budget for everything below the image,
     which doesn't itself depend on image size. */
  [data-services-track] {
    --services-card-image-size: min(446px, 72vw);
    height: calc(var(--services-card-image-size) + 345px);
  }

  /* Tablet gets its own tier, narrower than the mobile 446px cap — that cap
     is tuned for phone widths (72vw stops mattering and 446px takes over
     well before real tablet widths), so every tablet size was rendering the
     same flat 446px with almost no peek either side (confirmed at 816px
     wide: card filled the viewport bar ~100px per side). 400px restores a
     clearer peek without going as narrow as desktop, which has much more
     spare width to work with. */
  @media (min-width: 768px) {
    [data-services-track] {
      --services-card-image-size: 400px;
    }
  }

  /* Narrower still at desktop — matches the same 1200px threshold the rest
     of the site's "L" tier switches on. Height/content padding are
     untouched, so this only tightens the measure of the title/overview
     text, not how much of it fits. */
  @media (min-width: 1200px) {
    [data-services-track] {
      --services-card-image-size: 380px;
    }
  }

  .services-card {
    height: calc(var(--services-card-image-size) + 345px);
    width: var(--services-card-image-size);
  }

  /* Doubled on mobile specifically (20px vs the 10px the *1.25 formula
     alone would give at this tier) — read as too tight at real mobile
     widths even though the same formula reads fine from 768px up, so this
     overrides just the base tier rather than changing the shared formula
     everywhere. */
  .services-card-text {
    padding-inline: calc(var(--spacing-horizontal-m) * 2.5);
  }
  @media (min-width: 768px) {
    .services-card-text {
      padding-inline: calc(var(--spacing-horizontal-m) * 1.25);
    }
  }

  /* Sits behind the close handle and copy-email button, giving them a
     legible backdrop against whatever the photo underneath is doing —
     needed once the close handle lost its own background chip. Two
     separate fades stacked on the same element, both anchored at the top
     and softening to nothing by the same point, so neither reads as a hard
     edge: the tint via the gradient's own alpha stops, and the blur
     STRENGTH itself via mask-image (backdrop-filter has no way to vary its
     own intensity across an element — masking the element that carries it
     is the actual technique for a "graduating blur" rather than a blurred
     rectangle with a sharp cutoff). */
  .services-card-top-fade {
    background: linear-gradient(to bottom, rgba(13, 13, 13, 0.45), rgba(13, 13, 13, 0) 100%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to bottom, black, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 100%);
  }

  /* Press/release feel for the copy-email button, matching the nav pill's
     quick-firm-press + springy-overshoot-release — scale-based here rather
     than the pill's 3D tilt, since this is a small round icon button, not
     a wide shape a see-saw motion would read on. Release is driven by
     WAAPI (see script) so it can overshoot past 1 before settling; this
     transition is only what plays while actually held down. */
  .copy-email-btn.is-pressed {
    transform: scale(0.82);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .copy-email-btn.is-settling {
    transition: none;
  }
</style>

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../lib/scrollLock';

  const overlay = document.querySelector<HTMLElement>('[data-services-overlay]');
  const track = document.querySelector<HTMLElement>('[data-services-track]');
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>('[data-service-card]')) : [];
  const N = cards.length;

  let copyButtons: HTMLButtonElement[] = [];

  function isOpen() {
    return overlay?.dataset.open === 'true';
  }

  function setOpen(next: boolean) {
    if (!overlay) return;
    overlay.dataset.open = String(next);
    overlay.toggleAttribute('inert', !next);
    if (next) lockBodyScroll();
    else unlockBodyScroll();
  }

  // --- Positioning engine --------------------------------------------------
  //
  // `offset` is "which absolute slot is centred right now" — not clamped to
  // 0..N-1, so it freely grows or shrinks through any number of laps (e.g.
  // -14, 0, 23). Each card's actual on-screen slot is whichever of its
  // repeats (i, i±N, i±2N, ...) sits closest to `offset`, found fresh every
  // render via wrappedDelta below. That's what gives the infinite loop for
  // free, with no repeated DOM and no "silently jump the position once
  // you're deep enough into a copy" bookkeeping the previous scroll-based
  // version needed.
  //
  // `targetOffset` is separate: the authoritative "index we're heading to
  // or resting on", updated synchronously the instant any gesture/key/click
  // commits — never re-derived from `offset` itself (which can be
  // fractional or mid-animation). The previous version found "current
  // card" by checking scroll position, which was ambiguous while a native
  // smooth-scroll from the PREVIOUS commit was still mid-flight — a fast or
  // repeated swipe/key-press doesn't wait for it to finish, so two commits
  // in a row could each independently land on the wrong neighbour. Explicit
  // state instead of a re-derived guess removes that ambiguity outright,
  // and — since this whole engine owns the animation itself now instead of
  // handing it to the browser's native smooth-scroll — every gesture can
  // just cancel and redirect it instantly and deterministically.
  let offset = 0;
  let targetOffset = 0;

  // Recomputed fresh each call rather than cached, since the resting card
  // width changes at every breakpoint (and is itself fluid — min(446px,
  // 72vw) — below the tablet tier). getComputedStyle, not
  // getBoundingClientRect: the latter reflects the CURRENT rendered size
  // including whatever scale() a card presently has applied (peeking cards
  // are scaled down — see cardVisualState), which would silently corrupt
  // this if it ever happened to measure a non-centred card.
  function step(): number {
    if (!track || !cards[0]) return 0;
    const width = parseFloat(getComputedStyle(cards[0]).width) || 0;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    return width + gap;
  }

  // Shortest signed distance (in card-steps) from `from` to `index`,
  // wrapping around the N-card loop — e.g. with N=6, index 0 read from
  // from=5 is +1 away (wrap forward), not -5. Works for fractional `from`
  // too (mid-drag or mid-animation), which is what makes a single set of
  // real DOM cards behave like an infinite strip without ever needing to
  // silently reposition anything.
  function wrappedDelta(index: number, from: number): number {
    const raw = index - from;
    return raw - N * Math.round(raw / N);
  }

  // Scale/fade cards by distance from centre — the closer to centre, the
  // larger and more opaque, per the Figma annotation calling for "the rest
  // smaller and faded". One full step away (a peeking neighbour) is where
  // this bottoms out at its floor; 0.55 opacity / 0.85 scale keeps that
  // peeking card reading as "the next card" rather than washing out into
  // background blur.
  function cardVisualState(delta: number) {
    const t = Math.min(Math.abs(delta), 1);
    return { scale: 1 - t * 0.15, opacity: 1 - t * 0.45 };
  }

  // Only N (6) real elements exist now — no more 30-copy loop buffer to
  // skip-optimise around, so every card is simply repositioned every call.
  function render() {
    const s = step();
    cards.forEach((card, i) => {
      const delta = wrappedDelta(i, offset);
      const { scale, opacity } = cardVisualState(delta);
      card.style.transform = `translate(-50%, -50%) translateX(${delta * s}px) scale(${scale})`;
      card.style.opacity = String(opacity);
    });
  }

  // Self-owned tween from the current (possibly mid-drag) offset to an
  // absolute target — replaces native scrollTo({behavior:'smooth'}), which
  // couldn't be reliably interrupted or redirected mid-flight (see the
  // targetOffset comment above) and was the actual root of the "lands on
  // the wrong card" and "swipe sometimes does nothing" reports. Owning
  // start/cancel/redirect directly instead means a new gesture can always
  // cancel and take over cleanly, with nothing left running behind it.
  let tweenFrameId = 0;
  function cancelTween() {
    if (tweenFrameId) cancelAnimationFrame(tweenFrameId);
    tweenFrameId = 0;
  }

  function animateTo(target: number, durationMs = 380) {
    cancelTween();
    targetOffset = target;
    const start = offset;
    const delta = target - start;
    if (Math.abs(delta) < 0.001) {
      offset = target;
      render();
      return;
    }
    const startTime = performance.now();
    function tick(now: number) {
      const t = Math.min((now - startTime) / durationMs, 1);
      const eased = 1 - Math.pow(1 - t, 3); // ease-out-cubic
      offset = start + delta * eased;
      render();
      if (t < 1) {
        tweenFrameId = requestAnimationFrame(tick);
      } else {
        offset = target;
        render();
        tweenFrameId = 0;
      }
    }
    tweenFrameId = requestAnimationFrame(tick);
  }

  render();

  // Per the Figma annotation, the carousel "emerges from bottom of page" — driven
  // via WAAPI (not a CSS transition) so it can play per-card, staggered from the
  // centered card outward, and the exact reverse (outward in first, center last)
  // on close. Each card animates its own translateY entrance while holding its
  // cardVisualState scale/opacity (and its resting translateX) as the end value,
  // so it settles exactly where render() would have put it — no fighting
  // between the two.
  const SLIDE_DISTANCE = 120;
  const STAGGER_MS = 80;
  const STAGGER_RANGE = 2; // cards more than this far from center share the outermost delay

  function playOpenAnimation() {
    const s = step();
    cards.forEach((card, i) => {
      card.getAnimations().forEach((anim) => anim.cancel());
      // Same stale-hit-test-after-cancel concern as below, but for a leftover
      // animation from a previous open/close cycle (e.g. a close animation
      // still in its pre-start delay when the carousel is reopened) — flush
      // right away rather than only after this new animation's own finish.
      void card.offsetWidth;
      const delta = wrappedDelta(i, targetOffset);
      const { scale, opacity } = cardVisualState(delta);
      const x = delta * s;
      const distance = Math.min(Math.abs(delta), STAGGER_RANGE);
      const anim = card.animate(
        [
          {
            transform: `translate(-50%, -50%) translateX(${x}px) translateY(${SLIDE_DISTANCE}px) scale(${scale})`,
            opacity: 0,
          },
          { transform: `translate(-50%, -50%) translateX(${x}px) translateY(0) scale(${scale})`, opacity },
        ],
        {
          duration: 600,
          delay: distance * STAGGER_MS,
          easing: 'cubic-bezier(0.22, 1.36, 0.36, 1)',
          fill: 'forwards',
        }
      );
      // Release the animation once it settles so its fill:forwards effect stops
      // pinning transform/opacity — otherwise it permanently overrides render()
      // as the user scrolls/drags afterward, and the centered card stops
      // rescaling.
      anim.finished
        .then(() => {
          anim.cancel();
          // Chromium can leave a stale compositor hit-test region behind for a
          // card right after a WAAPI animation on it is cancelled — the paint
          // is correct (and elementFromPoint agrees), but real pointer input
          // can still resolve to the old hit-test rect for a bit, so clicks on
          // e.g. the copy-email button land on the track underneath instead.
          // Forcing a synchronous layout read flushes that stale state.
          void card.offsetWidth;
        })
        .catch(() => {});
    });
  }

  function playCloseAnimation() {
    const s = step();
    cards.forEach((card, i) => {
      card.getAnimations().forEach((anim) => anim.cancel());
      void card.offsetWidth;
      const delta = wrappedDelta(i, targetOffset);
      const { scale, opacity } = cardVisualState(delta);
      const x = delta * s;
      const distance = Math.min(Math.abs(delta), STAGGER_RANGE);
      // Reverse of the open stagger: farthest-from-center cards leave first,
      // the centered card leaves last.
      const delay = (STAGGER_RANGE - distance) * STAGGER_MS;
      card.animate(
        [
          { transform: `translate(-50%, -50%) translateX(${x}px) translateY(0) scale(${scale})`, opacity, offset: 0 },
          {
            transform: `translate(-50%, -50%) translateX(${x}px) translateY(${SLIDE_DISTANCE}px) scale(${scale})`,
            opacity,
            offset: 0.55,
          },
          {
            transform: `translate(-50%, -50%) translateX(${x}px) translateY(${SLIDE_DISTANCE}px) scale(${scale})`,
            opacity: 0,
            offset: 1,
          },
        ],
        { duration: 700, delay, easing: 'ease-in', fill: 'forwards' }
      );
    });
  }

  // The just-opened card is still settling into its centered position for a
  // brief moment after openAt() returns — real (trusted) clicks landing in
  // this window have been observed to occasionally hit the track underneath
  // a button instead of the button itself, which the backdrop-click-to-close
  // handler below would otherwise read as "clicked outside a card" and close
  // on. Ignoring backdrop-close clicks for a short settle window after
  // opening means a mistimed click is just a no-op instead of spuriously
  // closing the carousel.
  const OPEN_SETTLE_MS = 400;
  let openedAt = 0;

  function openAt(index: number) {
    setOpen(true);
    openedAt = performance.now();
    cancelTween();
    offset = index;
    targetOffset = index;
    render();
    playOpenAnimation();
  }

  function close() {
    playCloseAnimation();
    setOpen(false);
  }

  document.querySelectorAll<HTMLElement>('[data-service-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const index = Number(trigger.dataset.index) || 0;
      openAt(index);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-services-close]').forEach((btn) => {
    btn.addEventListener('click', close);
  });

  // Clicking anywhere that isn't a card (the overlay backdrop, or the track's own
  // padding/gap areas around the cards) closes the carousel.
  overlay?.addEventListener('click', (e) => {
    if (performance.now() - openedAt < OPEN_SETTLE_MS) return;
    const target = e.target as HTMLElement;
    if (target.closest('[data-service-card]')) return;
    close();
  });

  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') {
      close();
    } else if (e.key === 'ArrowRight') {
      animateTo(Math.round(targetOffset) + 1);
    } else if (e.key === 'ArrowLeft') {
      animateTo(Math.round(targetOffset) - 1);
    }
  });

  // Clicking a peeking (not-yet-centered) card brings it to centre — a
  // click naturally only fires when the pointer didn't move meaningfully
  // between down and up (that's the browser's own distinction, not custom
  // logic here), so this never fires as a spurious side effect of a real
  // swipe/drag being handled elsewhere. The close/copy-email buttons opt
  // out since they already have their own click behaviour.
  track?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-services-close]') || target.closest('[data-copy-email]')) return;
    const card = target.closest<HTMLElement>('[data-service-card]');
    if (!card) return;
    const idx = cards.indexOf(card);
    if (idx === -1) return;
    const delta = wrappedDelta(idx, targetOffset);
    if (delta === 0) return; // already centred
    animateTo(targetOffset + delta);
  });

  // Swipe-down-to-close, mobile/tablet only (below the desktop breakpoint) —
  // a standard bottom-sheet dismiss gesture, using the same drag-handle pill
  // (data-services-close) already rendered as a visual affordance for it.
  // Touch-only (mouse already has its own horizontal stepper below,
  // explicitly gated to pointerType 'mouse') so the two never compete for
  // the same pointer. Stays completely hands-off — no preventDefault, no
  // pointer capture — until the gesture is clearly vertical-dominant (a few
  // px of movement with |dy| > |dx|), so a real horizontal swipe between
  // cards is never intercepted or made to feel laggy.
  const SWIPE_CLOSE_THRESHOLD_PX = 100;
  const SWIPE_CLOSE_VELOCITY_PX_MS = 0.5;

  function isMobileOrTablet() {
    return window.innerWidth < 1200;
  }

  // Exactly-one-card-per-gesture: a swipe/drag of any length or speed
  // always resolves to exactly the next or previous card, never several.
  // Still live-follows the pointer during the drag (clamped to one card's
  // own step distance, so even a huge/fast drag can't visually pass more
  // than one neighbour) so it keeps the tactile, finger-tracks-the-card
  // feel rather than jumping straight from gesture to result.
  const STEP_COMMIT_THRESHOLD_PX = 10;

  let dragPointerId: number | null = null;
  let dragStartX = 0;
  let dragStartOffset = 0; // offset's own value at drag start — for live-follow continuity from wherever things visually are right now
  let dragStartTarget = 0; // targetOffset's value at drag start — the authoritative basis the eventual commit is relative to
  let dragCaptured = false;

  function startCardStep(pointerId: number, clientX: number) {
    if (!track) return;
    // A new gesture always takes over immediately — cancelling any
    // still-running tween means nothing is left fighting this drag's own
    // writes to `offset`.
    cancelTween();
    dragPointerId = pointerId;
    dragStartX = clientX;
    dragStartOffset = offset;
    dragStartTarget = targetOffset;
    dragCaptured = false;
  }

  // The actual offset write is throttled to once per animation frame
  // (below), not once per pointermove — touch in particular can fire
  // pointermove far faster than the screen can repaint, and rewriting
  // transform/opacity on every raw event was almost certainly the real
  // source of the drag feeling jerky. Batching every event that arrives
  // within one frame down to a single write is the standard fix.
  let moveRafId = 0;
  let pendingClientX = 0;

  function moveCardStep(clientX: number) {
    if (dragPointerId === null) return;
    const s = step();
    if (!s) return;
    if (!dragCaptured) {
      dragCaptured = true;
      try {
        track?.setPointerCapture(dragPointerId);
      } catch {
        // Can legitimately fail if the pointer was already released between
        // startCardStep and this first move (e.g. an extremely quick
        // tap-drag) — the gesture just won't be captured, harmless.
      }
    }
    pendingClientX = clientX;
    if (moveRafId) return;
    moveRafId = requestAnimationFrame(() => {
      moveRafId = 0;
      if (dragPointerId === null) return;
      const dx = pendingClientX - dragStartX;
      const clampedDx = Math.max(-s, Math.min(s, dx));
      offset = dragStartOffset - clampedDx / s;
      render();
    });
  }

  // Direction only, not distance or velocity, decides the outcome — that's
  // the whole point of this replacing a free scroll. Below the commit
  // threshold (a real drag was never confirmed, e.g. a click/tap with a
  // pixel or two of jitter), springs back to the card the gesture started
  // on instead of stepping.
  function endCardStep(clientX: number) {
    if (dragPointerId === null) return;
    cancelAnimationFrame(moveRafId);
    moveRafId = 0;
    const dx = clientX - dragStartX;
    const wasCaptured = dragCaptured;
    const startTarget = dragStartTarget;
    const endedPointerId = dragPointerId;
    dragPointerId = null;
    dragCaptured = false;
    // Explicit release rather than relying solely on the implicit release a
    // pointerup/pointercancel is supposed to trigger on its own — real
    // mobile browsers have known inconsistencies here, and a stale capture
    // left on the track can affect how the NEXT touch's events are
    // delivered to it, which is consistent with swipes only working every
    // other attempt (an intervening tap/click elsewhere was what actually
    // cleared it, not anything this code was doing).
    if (wasCaptured) {
      try {
        track?.releasePointerCapture(endedPointerId);
      } catch {
        // Already released/invalid — nothing to clean up.
      }
    }
    if (!wasCaptured) return;
    let target = Math.round(startTarget);
    if (dx <= -STEP_COMMIT_THRESHOLD_PX) target = Math.round(startTarget) + 1;
    else if (dx >= STEP_COMMIT_THRESHOLD_PX) target = Math.round(startTarget) - 1;
    animateTo(target);
  }

  let swipeCard: HTMLElement | null = null;
  let swipeScale = 1;
  let swipeStartX = 0;
  let swipeStartY = 0;
  let swipeStartTime = 0;
  let swipeDeltaY = 0;
  let swipeDirection: 'vertical' | 'horizontal' | null = null;
  let swipePointerId: number | null = null;

  // Distinct from close() (used by the pill button/Escape/backdrop click):
  // that path always animates cards from a resting translateY(0), which
  // would visibly snap the dragged card back to 0 before playing — jarring
  // right after a swipe that's already partway through that same motion.
  // This continues the drag's own motion off-screen instead of restarting it.
  function closeViaSwipe(card: HTMLElement, fromY: number, scale: number) {
    setOpen(false);
    cards.forEach((c) => {
      if (c === card) return;
      c.getAnimations().forEach((a) => a.cancel());
      c.animate([{ opacity: getComputedStyle(c).opacity }, { opacity: 0 }], {
        duration: 250,
        easing: 'ease-out',
        fill: 'forwards',
      });
    });
    card.getAnimations().forEach((a) => a.cancel());
    const anim = card.animate(
      [
        {
          transform: `translate(-50%, -50%) scale(${scale}) translateY(${fromY}px)`,
          opacity: getComputedStyle(card).opacity,
        },
        { transform: `translate(-50%, -50%) scale(${scale}) translateY(${fromY + SLIDE_DISTANCE}px)`, opacity: 0 },
      ],
      { duration: 350, easing: 'ease-in', fill: 'forwards' }
    );
    anim.finished.then(() => anim.cancel()).catch(() => {});
  }

  // `swipeCard` is only ever needed for the VERTICAL branch (the specific
  // element to animate a dismiss on) — it must not also gate whether a
  // gesture starts at all. Cards are absolutely positioned now, with real
  // gaps between them (the peeking-card spacing), so a touch starting in
  // one of those gaps has no `[data-service-card]` ancestor — requiring
  // one here meant that touch silently did nothing at all, for either
  // direction, which is what kept reading as swipes randomly not
  // responding on mobile depending on exactly where the thumb landed.
  // `swipePointerId` (not `swipeCard`) is the "is a gesture active" gate.
  track?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'touch' || !isMobileOrTablet() || !track) return;
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-service-card]');
    swipeCard = card;
    swipeScale = card ? cardVisualState(wrappedDelta(cards.indexOf(card), targetOffset)).scale : 1;
    swipeStartX = e.clientX;
    swipeStartY = e.clientY;
    swipeStartTime = e.timeStamp;
    swipeDeltaY = 0;
    swipeDirection = null;
    swipePointerId = e.pointerId;
  });

  track?.addEventListener('pointermove', (e) => {
    if (swipePointerId === null || e.pointerId !== swipePointerId || !track) return;
    const dx = e.clientX - swipeStartX;
    const dy = e.clientY - swipeStartY;

    if (!swipeDirection) {
      // Wait for enough movement to confidently read the gesture's
      // direction — locking on the first pixel of jitter would misclassify
      // real horizontal swipes.
      if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
      const wantsVertical = Math.abs(dy) > Math.abs(dx);
      if (wantsVertical && !swipeCard) {
        // A vertical swipe with no specific card under the thumb (started
        // in a gap) has nothing to animate a dismiss on — abandon just
        // this gesture rather than misreading it as horizontal.
        swipePointerId = null;
        return;
      }
      swipeDirection = wantsVertical ? 'vertical' : 'horizontal';
      if (swipeDirection === 'vertical') {
        swipeCard!.setPointerCapture(swipePointerId);
      } else {
        // A real horizontal swipe — handed off to the shared exactly-one-
        // card-per-gesture stepper above.
        startCardStep(swipePointerId, swipeStartX);
      }
    }

    if (swipeDirection === 'horizontal') {
      e.preventDefault();
      moveCardStep(e.clientX);
      return;
    }

    if (swipeDirection !== 'vertical') return;
    e.preventDefault();
    swipeDeltaY = Math.max(0, dy); // downward only — an upward drag is a no-op
    swipeCard!.style.transform = `translate(-50%, -50%) scale(${swipeScale}) translateY(${swipeDeltaY}px)`;
    swipeCard!.style.opacity = String(Math.max(0.4, 1 - swipeDeltaY / 400));
  });

  function endSwipe(e: PointerEvent) {
    if (swipePointerId === null || e.pointerId !== swipePointerId || !track) return;
    const card = swipeCard;
    const direction = swipeDirection;
    const endedPointerId = swipePointerId;
    swipeCard = null;
    swipeDirection = null;
    // Explicit reset/release rather than leaning on the next pointerdown to
    // overwrite these — see the matching comment in endCardStep. Real
    // mobile browsers don't always fire the implicit pointer-capture
    // release as reliably as the spec implies, and a stale capture left on
    // the card can affect the NEXT swipe's own events, which matches
    // swipes only working every other attempt (an intervening tap/click
    // elsewhere was what actually cleared it, not this code).
    swipePointerId = null;
    if (direction === 'vertical' && card) {
      try {
        card.releasePointerCapture(endedPointerId);
      } catch {
        // Already released/invalid — nothing to clean up.
      }
    }

    if (direction === 'horizontal') {
      endCardStep(e.clientX);
      return;
    }

    // A vertical direction is never set without a card (see pointermove
    // above), so this is just satisfying the type checker.
    if (direction !== 'vertical' || !card) return;

    const elapsed = e.timeStamp - swipeStartTime;
    const velocity = swipeDeltaY / Math.max(elapsed, 1);
    if (swipeDeltaY > SWIPE_CLOSE_THRESHOLD_PX || velocity > SWIPE_CLOSE_VELOCITY_PX_MS) {
      closeViaSwipe(card, swipeDeltaY, swipeScale);
    } else {
      // Under threshold — spring back, same overshoot-and-settle language
      // as every other press/release interaction on the site.
      card.getAnimations().forEach((a) => a.cancel());
      const settle = card.animate(
        [
          {
            transform: `translate(-50%, -50%) scale(${swipeScale}) translateY(${swipeDeltaY}px)`,
            opacity: card.style.opacity,
          },
          { transform: `translate(-50%, -50%) scale(${swipeScale}) translateY(-8px)`, opacity: 1, offset: 0.7 },
          { transform: `translate(-50%, -50%) scale(${swipeScale}) translateY(0)`, opacity: 1 },
        ],
        { duration: 380, easing: 'ease-out', fill: 'forwards' }
      );
      settle.finished
        .then(() => {
          settle.cancel();
          // Unlike the old flow-layout version, there's no CSS default for
          // this card to fall back to once the inline style is cleared —
          // position is 100% JS-driven now, so re-assert its normal resting
          // transform instead of clearing it to nothing.
          render();
        })
        .catch(() => {});
    }
  }

  track?.addEventListener('pointerup', endSwipe);
  track?.addEventListener('pointercancel', endSwipe);

  // Mouse drag: same exactly-one-card-per-gesture stepper as the touch
  // horizontal path above. Pointer capture is deferred to moveCardStep's
  // first real call rather than happening unconditionally on pointerdown
  // (i.e. on every plain click too), since doing either on a click with no
  // drag has been observed to make Chrome's compositor-thread hit-testing
  // briefly resolve the click to the track underneath instead of the
  // card/button actually under the cursor.
  track?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || !track) return;
    startCardStep(e.pointerId, e.clientX);
  });

  track?.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || dragPointerId !== e.pointerId) return;
    moveCardStep(e.clientX);
  });

  function endMouseStep(e: PointerEvent) {
    if (e.pointerType !== 'mouse' || dragPointerId !== e.pointerId) return;
    endCardStep(e.clientX);
  }

  track?.addEventListener('pointerup', endMouseStep);
  track?.addEventListener('pointercancel', endMouseStep);

  // Trackpad/mouse-wheel: same exactly-one-card-per-gesture stepper as
  // touch and mouse-drag above, not free scrolling — a two-finger trackpad
  // swipe is the most common way this carousel actually gets used on a Mac,
  // so a fast swipe flying past several cards would be exactly the
  // "several cards at once" behaviour this whole stepper exists to avoid.
  //
  // Wheel events have no distinct start/end the way pointer events do — a
  // single physical trackpad swipe fires many small 'wheel' events in
  // quick succession, not one. A synthetic pointerId plus an idle timeout
  // stands in for that: the gesture is "live" for as long as events keep
  // arriving, and only commits once they stop for a beat.
  const WHEEL_POINTER_ID = -999;
  const WHEEL_IDLE_MS = 100;
  let wheelActive = false;
  let wheelVirtualX = 0;
  let wheelIdleTimeoutId = 0;

  track?.addEventListener(
    'wheel',
    (e) => {
      // Don't fight an actual touch/mouse-drag gesture already in progress.
      if (dragPointerId !== null && dragPointerId !== WHEEL_POINTER_ID) return;

      if (!wheelActive) {
        // Vertical-dominant input (a plain mouse wheel, or a trackpad
        // scroll that's mostly vertical) is left alone — only a genuinely
        // horizontal gesture takes over the carousel. But this check is
        // only meaningful for deciding whether to START a gesture — real
        // trackpad hardware produces noisy per-event deltas (especially as
        // a swipe decelerates near its end, where deltaX shrinks toward 0
        // and deltaY can briefly exceed it even mid-swipe), so re-running
        // this same check on every event of an already-active gesture
        // silently dropped some of them entirely — their deltaX never
        // reached wheelVirtualX below, AND the idle-timeout didn't get
        // refreshed for them either, which could end the gesture early,
        // mid-swipe. That's what read as a trackpad swipe sometimes doing
        // nothing. Once a gesture is active, every event belongs to it
        // regardless of that event's own delta ratio.
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        wheelActive = true;
        wheelVirtualX = 0;
        startCardStep(WHEEL_POINTER_ID, 0);
      }

      e.preventDefault();
      // Scrolling "forward" (deltaX > 0, the same direction as swiping left
      // to reveal the next card) has to decrease this virtual position to
      // match — moveCardStep/endCardStep read direction from clientX
      // decreasing exactly the way a real leftward drag would.
      wheelVirtualX -= e.deltaX;
      moveCardStep(wheelVirtualX);
      window.clearTimeout(wheelIdleTimeoutId);
      wheelIdleTimeoutId = window.setTimeout(() => {
        wheelActive = false;
        endCardStep(wheelVirtualX);
      }, WHEEL_IDLE_MS);
    },
    { passive: false }
  );

  copyButtons = overlay ? Array.from(overlay.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) : [];
  copyButtons.forEach((copyButton) => {
    const status = copyButton.parentElement?.querySelector<HTMLElement>('[data-copy-email-status]');
    const track = status?.querySelector<HTMLElement>('[data-copy-email-status-track]');
    const result = status?.querySelector<HTMLElement>('[data-copy-email-status-result]');
    let hideTimeout = 0;

    // Same two-row roll used for the nav's Menu/Close toggle: a fixed-height
    // window with both labels stacked in a flex column, translated up by
    // half its own height to swap which row shows. The tooltip element also
    // doubles as the hover label ("Enquire now", shown via CSS group-hover)
    // — the inline opacity set here temporarily overrides that, then clears
    // afterward so it falls back to plain CSS hover behavior once the
    // click-feedback window ends, rather than getting stuck.
    function showStatus(text: string) {
      if (!status || !track || !result) return;
      window.clearTimeout(hideTimeout);
      result.textContent = text;
      status.style.opacity = '1';
      track.classList.add('-translate-y-1/2');
      hideTimeout = window.setTimeout(() => {
        status.style.opacity = '';
        track.classList.remove('-translate-y-1/2');
      }, 1500);
    }

    // Press/release: same quick-firm-press-in then springy-overshoot-release
    // as the nav pill, scale-based instead of the pill's 3D tilt.
    let settleAnim: Animation | null = null;

    copyButton.addEventListener('pointerdown', () => {
      settleAnim?.cancel();
      copyButton.classList.remove('is-settling');
      copyButton.classList.add('is-pressed');
    });

    const releasePress = () => {
      if (!copyButton.classList.contains('is-pressed')) return;
      settleAnim = copyButton.animate(
        [
          { transform: 'scale(0.82)' },
          { transform: 'scale(1.12)', offset: 0.55 },
          { transform: 'scale(0.97)', offset: 0.8 },
          { transform: 'scale(1)' },
        ],
        { duration: 380, easing: 'ease-out', fill: 'forwards' }
      );
      copyButton.classList.add('is-settling');
      copyButton.classList.remove('is-pressed');

      const anim = settleAnim;
      anim.finished
        .then(() => {
          anim.cancel();
          copyButton.classList.remove('is-settling');
        })
        .catch(() => {});
    };

    copyButton.addEventListener('pointerup', releasePress);
    copyButton.addEventListener('pointerleave', releasePress);
    copyButton.addEventListener('pointercancel', releasePress);

    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        showStatus('Email copied');
      } catch (err) {
        // Surfaced instead of silently swallowed — a failure here (blocked
        // clipboard permission, insecure context, etc.) previously looked
        // identical to success: the button just did nothing either way.
        console.error('Copy email to clipboard failed:', err);
        showStatus("Couldn't copy — try again");
      }
    });
  });
</script>
