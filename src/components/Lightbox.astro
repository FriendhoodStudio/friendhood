---
// Case-study image lightbox. Any `[data-lightbox-image]` on the page —
// the hero image, body media images, and every image inside every
// ImageCarousel instance — opens this on click, flattened into one
// full-screen carousel across the WHOLE page rather than each image's own
// context. Rendered once per page; the script queries the marker
// attribute globally, so nothing else needs to know this exists.
---

<div
  data-lightbox-overlay
  data-open="false"
  inert
  class="pointer-events-none fixed inset-0 z-[70] flex items-center justify-center bg-back/95 p-[14px] opacity-0 backdrop-blur-[10px] transition-opacity duration-400 ease-in-out data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 sm:p-[24px]"
>
  <button
    type="button"
    data-lightbox-close
    aria-label="Close"
    class="lightbox-btn absolute right-[14px] top-[14px] z-10 flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110 sm:right-[24px] sm:top-[24px]"
  >
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M1 1L17 17M17 1L1 17" stroke="#F3FAF0" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>

  {/* Rotating to landscape already TRIES to enter fullscreen on its own
      (see the script) — but the Fullscreen API only ever grants that from
      a genuine, direct user gesture (a tap), never from an orientation-
      change event, so most mobile browsers (Safari especially) silently
      refuse the automatic attempt and the browser's own chrome stays
      visible. This button is the reliable fallback: a real tap, shown
      only when it's actually relevant (open, mobile, landscape). */}
  <button
    type="button"
    data-lightbox-fullscreen
    hidden
    aria-label="Toggle fullscreen"
    class="lightbox-btn absolute left-[14px] top-[14px] z-10 flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110 sm:left-[24px] sm:top-[24px]"
  >
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path
        d="M2 6.5V3a1 1 0 0 1 1-1h3.5M15.5 6.5V3a1 1 0 0 0-1-1H11M2 11.5V15a1 1 0 0 0 1 1h3.5M15.5 11.5V15a1 1 0 0 1-1 1H11"
        stroke="#F3FAF0"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  {/* Only meaningful with more than one image on the page — hidden via
      script (same auto-disable idiom as ImageCarousel's own prev/next)
      rather than a build-time check, since the full flattened count isn't
      known until every component on the page has rendered. */}
  <button
    type="button"
    data-lightbox-prev
    aria-label="Previous image"
    class="lightbox-btn absolute left-[14px] top-1/2 z-10 flex h-[52px] w-[52px] -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110 sm:left-[24px]"
  >
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M11 2.5L4.5 9L11 15.5" stroke="#F3FAF0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button
    type="button"
    data-lightbox-next
    aria-label="Next image"
    class="lightbox-btn absolute right-[14px] top-1/2 z-10 flex h-[52px] w-[52px] -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110 sm:right-[24px]"
  >
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M7 2.5L13.5 9L7 15.5" stroke="#F3FAF0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  {/* Common coordinate space both images slide within — sized to the
      overlay's own full padded content box (not to either image's natural
      size) specifically so there's a shared 100%-wide track to translateX
      across. Each image is then individually letterboxed inside that same
      box via object-contain, exactly as a single centred image was
      before. touch-action: none hands touch gesture recognition entirely
      to the JS drag below — same reasoning as the services carousel: without
      it, a thumb drag was fighting the browser's own native scroll/pan
      gesture on the same element.

      This fills the whole overlay and comes AFTER the three buttons above
      in DOM order, so without z-10 on those buttons it would silently
      paint and hit-test in front of them — same bug class as the services
      card's copy-email wrapper swallowing clicks meant for the button
      underneath it. */}
  <div data-lightbox-stage class="relative h-full w-full overflow-hidden" style="touch-action: none;">
    <img
      data-lightbox-image-current
      src=""
      alt=""
      class="absolute inset-0 h-full w-full select-none object-contain"
      draggable="false"
    />
    <img
      data-lightbox-image-incoming
      src=""
      alt=""
      class="absolute inset-0 h-full w-full select-none object-contain opacity-0"
      draggable="false"
    />
  </div>
</div>

<style>
  .lightbox-btn.is-pressed {
    transform: scale(0.82);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lightbox-btn.is-settling {
    transition: none;
  }
</style>

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../lib/scrollLock';

  const overlay = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
  const stage = document.querySelector<HTMLElement>('[data-lightbox-stage]');
  const currentEl = document.querySelector<HTMLImageElement>('[data-lightbox-image-current]');
  const incomingEl = document.querySelector<HTMLImageElement>('[data-lightbox-image-incoming]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const fullscreenBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-fullscreen]');

  if (overlay && stage && currentEl && incomingEl && closeBtn && prevBtn && nextBtn && fullscreenBtn) {
    // Every marked image on the page, in DOM order — the hero, each body
    // media image, and every image inside every ImageCarousel instance —
    // flattened into one list regardless of which component rendered it,
    // so paging through from any starting point covers the whole page.
    const sources = Array.from(document.querySelectorAll<HTMLImageElement>('[data-lightbox-image]'));
    const multiple = sources.length > 1;
    prevBtn.hidden = !multiple;
    nextBtn.hidden = !multiple;

    let currentIndex = 0;
    const SLIDE_MS = 400;
    const SLIDE_EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';

    function srcFor(index: number) {
      const source = sources[index];
      return source ? { src: source.currentSrc || source.src, alt: source.alt } : null;
    }

    // Slides the CURRENT image out and the image at `index` in from the
    // appropriate side, then settles both elements back into their resting
    // roles — current visible at rest, incoming hidden and repositioned,
    // ready for the next call. `direction` is +1 for next (incoming enters
    // from the right, current exits left) or -1 for prev (mirrored) —
    // independent of how the change was triggered (button, key, or swipe),
    // so a keyboard press and a swipe animate identically.
    let settleAnim: Animation[] = [];
    function goTo(index: number, direction: 1 | -1) {
      settleAnim.forEach((a) => a.cancel());
      const upcoming = srcFor(index);
      if (!upcoming) return;
      currentIndex = index;
      incomingEl!.src = upcoming.src;
      incomingEl!.alt = upcoming.alt;
      incomingEl!.style.opacity = '1';
      incomingEl!.style.translate = `${direction * 100}% 0`;

      const currentAnim = currentEl!.animate(
        [{ translate: '0 0' }, { translate: `${-direction * 100}% 0` }],
        { duration: SLIDE_MS, easing: SLIDE_EASING, fill: 'forwards' }
      );
      const incomingAnim = incomingEl!.animate(
        [{ translate: `${direction * 100}% 0` }, { translate: '0 0' }],
        { duration: SLIDE_MS, easing: SLIDE_EASING, fill: 'forwards' }
      );
      settleAnim = [currentAnim, incomingAnim];

      Promise.all([currentAnim.finished, incomingAnim.finished])
        .then(() => {
          currentAnim.cancel();
          incomingAnim.cancel();
          // Incoming becomes the new resting "current" — copying its
          // already-loaded src rather than swapping element roles keeps
          // every other reference (and the CSS below) pointing at the
          // same two elements permanently.
          currentEl!.src = upcoming.src;
          currentEl!.alt = upcoming.alt;
          currentEl!.style.translate = '0 0';
          incomingEl!.style.opacity = '0';
          incomingEl!.style.translate = '0 0';
        })
        .catch(() => {});
    }

    // Tilting the phone to landscape while the lightbox is open reads as
    // "give me the whole screen for this" — the same reasoning as the Hero
    // showreel's own tilt-to-fullscreen (see there). Unlike that video
    // modal, exiting fullscreen here (rotating back, the browser's own
    // fullscreen-exit control) does NOT close the lightbox — there's no
    // "swipe to dismiss" gesture tied to fullscreen the way the video
    // reel's iOS player has, so the more natural reading is "stop being
    // fullscreen", not "stop viewing images". It only resets the flag so
    // tilting to landscape again can re-trigger it.
    let lightboxWentFullscreen = false;

    function enterLightboxFullscreen() {
      if (lightboxWentFullscreen || overlay!.dataset.open !== 'true') return;
      if (document.fullscreenElement) return;
      lightboxWentFullscreen = true;
      overlay!.requestFullscreen?.().catch(() => {
        lightboxWentFullscreen = false;
      });
    }

    // The manual button only ever needs to exist where the automatic
    // attempt above can actually fail and matter: open, mobile, landscape.
    // Elsewhere the fixed inset-0 overlay already reads as "full screen"
    // on its own, so there's nothing for the button to offer.
    function updateFullscreenButtonVisibility() {
      const eligible =
        overlay!.dataset.open === 'true' &&
        window.matchMedia('(max-width: 767px)').matches &&
        window.matchMedia('(orientation: landscape)').matches;
      fullscreenBtn!.hidden = !eligible;
    }

    function handleLightboxOrientationChange() {
      updateFullscreenButtonVisibility();
      if (!window.matchMedia('(max-width: 767px)').matches) return;
      if (window.matchMedia('(orientation: landscape)').matches) {
        enterLightboxFullscreen();
      }
    }

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) lightboxWentFullscreen = false;
    });
    window.matchMedia('(orientation: landscape)').addEventListener('change', handleLightboxOrientationChange);

    fullscreenBtn.addEventListener('click', () => {
      if (document.fullscreenElement === overlay) {
        document.exitFullscreen().catch(() => {});
      } else {
        lightboxWentFullscreen = true;
        overlay!.requestFullscreen?.().catch(() => {
          lightboxWentFullscreen = false;
        });
      }
    });

    function open(index: number) {
      currentIndex = index;
      const source = srcFor(index);
      if (source) {
        currentEl!.src = source.src;
        currentEl!.alt = source.alt;
      }
      incomingEl!.style.opacity = '0';
      incomingEl!.style.translate = '0 0';
      overlay!.dataset.open = 'true';
      overlay!.removeAttribute('inert');
      lockBodyScroll();
      lightboxWentFullscreen = false;
      // Covers opening the lightbox while the phone is already lying
      // landscape, not just tilting into landscape after the fact.
      handleLightboxOrientationChange();
    }

    function close() {
      overlay!.dataset.open = 'false';
      overlay!.setAttribute('inert', '');
      unlockBodyScroll();
      if (document.fullscreenElement === overlay) document.exitFullscreen().catch(() => {});
      updateFullscreenButtonVisibility();
    }

    function next() {
      goTo((currentIndex + 1) % sources.length, 1);
    }

    function prev() {
      goTo((currentIndex - 1 + sources.length) % sources.length, -1);
    }

    sources.forEach((source, index) => {
      source.addEventListener('click', () => open(index));
    });

    closeBtn.addEventListener('click', close);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);

    overlay.addEventListener('click', (e) => {
      // Only the backdrop itself, not the stage or any control, all of
      // which are also technically within the overlay's own click target.
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', (e) => {
      if (overlay!.dataset.open !== 'true') return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight' && multiple) next();
      else if (e.key === 'ArrowLeft' && multiple) prev();
    });

    // Touch/thumb drag — live-follows the finger by scrubbing the exact
    // same current/incoming pair goTo() animates, just driven by pointer
    // position instead of WAAPI, so a real drag and a tap-triggered slide
    // use the same two elements and always look like one continuous
    // motion rather than a drag that's disconnected from the "real" slide.
    // Direction isn't known until the first real move (a few px of
    // slack), since a swipe can start either way.
    const SWIPE_COMMIT_THRESHOLD_PX = 50;
    let swipePointerId: number | null = null;
    let swipeStartX = 0;
    let swipeDirection: 1 | -1 | null = null;

    stage.addEventListener('pointerdown', (e) => {
      if (!multiple) return;
      swipePointerId = e.pointerId;
      swipeStartX = e.clientX;
      swipeDirection = null;
      stage!.setPointerCapture(e.pointerId);
    });

    stage.addEventListener('pointermove', (e) => {
      if (swipePointerId !== e.pointerId) return;
      const dx = e.clientX - swipeStartX;
      if (!swipeDirection) {
        if (Math.abs(dx) < 4) return;
        swipeDirection = dx < 0 ? 1 : -1;
        const upcoming = srcFor((currentIndex + swipeDirection + sources.length) % sources.length);
        if (!upcoming) return;
        incomingEl!.style.transition = 'none';
        incomingEl!.src = upcoming.src;
        incomingEl!.alt = upcoming.alt;
        incomingEl!.style.opacity = '1';
        currentEl!.style.transition = 'none';
      }
      const clampedDx = Math.max(-stage!.clientWidth, Math.min(stage!.clientWidth, dx));
      currentEl!.style.translate = `${clampedDx}px 0`;
      incomingEl!.style.translate = `${clampedDx + swipeDirection * stage!.clientWidth}px 0`;
    });

    function endSwipe(e: PointerEvent) {
      if (swipePointerId !== e.pointerId) return;
      swipePointerId = null;
      if (!swipeDirection) return;
      const dx = e.clientX - swipeStartX;
      currentEl!.style.transition = `translate ${SLIDE_MS}ms ${SLIDE_EASING}`;
      incomingEl!.style.transition = `translate ${SLIDE_MS}ms ${SLIDE_EASING}`;
      if (Math.abs(dx) >= SWIPE_COMMIT_THRESHOLD_PX) {
        const direction = swipeDirection;
        currentEl!.style.translate = `${-direction * 100}% 0`;
        incomingEl!.style.translate = '0 0';
        const nextIndex = (currentIndex + direction + sources.length) % sources.length;
        window.setTimeout(() => {
          currentEl!.style.transition = 'none';
          incomingEl!.style.transition = 'none';
          currentIndex = nextIndex;
          const settled = srcFor(currentIndex);
          if (settled) {
            currentEl!.src = settled.src;
            currentEl!.alt = settled.alt;
          }
          currentEl!.style.translate = '0 0';
          incomingEl!.style.opacity = '0';
          incomingEl!.style.translate = '0 0';
        }, SLIDE_MS);
      } else {
        currentEl!.style.translate = '0 0';
        incomingEl!.style.translate = `${swipeDirection * 100}% 0`;
        window.setTimeout(() => {
          currentEl!.style.transition = 'none';
          incomingEl!.style.transition = 'none';
          incomingEl!.style.opacity = '0';
          incomingEl!.style.translate = '0 0';
        }, SLIDE_MS);
      }
      swipeDirection = null;
    }

    stage.addEventListener('pointerup', endSwipe);
    stage.addEventListener('pointercancel', endSwipe);

    // Overshoot-and-settle press feedback, same as every other icon button
    // on the site.
    [closeBtn, prevBtn, nextBtn, fullscreenBtn].forEach((btn) => {
      let pressAnim: Animation | null = null;

      btn.addEventListener('pointerdown', () => {
        pressAnim?.cancel();
        btn.classList.remove('is-settling');
        btn.classList.add('is-pressed');
      });

      const releasePress = () => {
        if (!btn.classList.contains('is-pressed')) return;
        pressAnim = btn.animate(
          [
            { transform: 'scale(0.82)' },
            { transform: 'scale(1.12)', offset: 0.55 },
            { transform: 'scale(0.97)', offset: 0.8 },
            { transform: 'scale(1)' },
          ],
          { duration: 380, easing: 'ease-out', fill: 'forwards' }
        );
        btn.classList.add('is-settling');
        btn.classList.remove('is-pressed');

        const anim = pressAnim;
        anim.finished
          .then(() => {
            anim.cancel();
            btn.classList.remove('is-settling');
          })
          .catch(() => {});
      };

      btn.addEventListener('pointerup', releasePress);
      btn.addEventListener('pointerleave', releasePress);
      btn.addEventListener('pointercancel', releasePress);
    });
  }
</script>
