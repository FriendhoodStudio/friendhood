---
import { fetchNavMenu } from '../lib/sanity/queries';
import type { PageLink, ContactLink } from '../types/navMenu';

const STAGGER_MS = 60;

const navMenu = await fetchNavMenu();

const pageLinks: PageLink[] = navMenu?.pageLinks ?? [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
];

const contactLinks: ContactLink[] = navMenu?.contactLinks ?? [
  { label: 'Email', linkType: 'email', email: 'hello@friendhood.co.uk' },
  { label: 'LinkedIn', linkType: 'link', href: '#' },
  { label: 'Instagram', linkType: 'link', href: '#' },
];
---

<div
  data-nav-overlay
  class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-start overflow-y-auto bg-back/60 px-[var(--page-margin)] pt-[max(148px,min(var(--spacing-vertical-xl),12vh))] pb-[130px] text-center opacity-0 backdrop-blur-[25px] transition-opacity duration-400 ease-in-out group-data-[open=true]:pointer-events-auto group-data-[open=true]:opacity-100"
>
  <div class="flex flex-1 flex-col items-center gap-vertical-l">
    <nav class="flex flex-col items-center gap-[15px]">
      {pageLinks.map((link, i) => (
        <a
          href={link.href}
          class="menu-item menu-link nav-menu-page-link font-display text-h1 text-front"
          data-delay={i * STAGGER_MS}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex flex-col items-center gap-[10px]">
      <p class="menu-item font-tag text-detail text-front" data-delay={pageLinks.length * STAGGER_MS}>
        Contact
      </p>
      <div class="flex flex-col items-center gap-vertical-xs">
        {contactLinks.map((link, i) =>
          link.linkType === 'email' ? (
            <button
              type="button"
              data-copy-email
              data-email={link.email}
              class="menu-item menu-link font-heading text-h3 text-accent-yellow block cursor-pointer text-left"
              data-delay={(pageLinks.length + 1 + i) * STAGGER_MS}
            >
              <span data-copy-email-label>{link.label}</span>
            </button>
          ) : (
            <a
              href={link.href}
              class="menu-item menu-link font-heading text-h3 text-accent-yellow"
              data-delay={(pageLinks.length + 1 + i) * STAGGER_MS}
            >
              {link.label}
            </a>
          )
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .menu-item {
    opacity: 0;
  }

  /* Applied once the WAAPI entrance animation finishes and is cancelled —
     see playEntrance() below. A fill:forwards WAAPI animation keeps
     overriding the `translate` property indefinitely, which would silently
     block any future translate change on this element, so control is
     handed back to plain CSS. (translate, not scale — the press/release
     overshoot below animates scale instead, a separate property, so the
     two never fight each other.) */
  .menu-item.is-settled {
    opacity: 1;
    translate: 0 0;
  }

  /* scale, not translate, and press/release overshoot to match every other
     button on the site (copy-email, reel trigger, lightbox controls) —
     replaces the earlier hover-only translate nudge, which had no press
     feedback at all. Shallow amounts (0.95 press / 1.1 hover), matching the
     established "wide element" convention (reel-trigger-btn, footer
     buttons) rather than the deeper 0.82/1.12 one used for small round
     icon buttons — these are large headline-sized text links, not icons. */
  .menu-link {
    transition: translate 300ms ease-out, scale 300ms ease-out;
  }
  .menu-link:hover {
    scale: 1.1;
  }
  .menu-link.is-pressed {
    scale: 0.95;
    transition: scale 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-link.is-settling {
    transition: none;
  }

  /* Same trial Heavy weight as the Hero H1 (see global.css's @font-face
     comment on "Greed Extended Heavy Trial") — used here too per explicit
     go-ahead despite it not being the licensed file yet. Falls back to the
     regular Greed Extended (already loaded via font-display) if the trial
     file is ever pulled, rather than dropping to the generic sans-serif. */
  .nav-menu-page-link {
    font-family: "Greed Extended Heavy Trial", "Greed Extended", sans-serif;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-nav-bar]');
  const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
  const menuItems = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>('.menu-item')) : [];

  // Driven entirely via the Web Animations API (rather than a CSS `animation`
  // that auto-plays once on page load and has to be reset) so entrance always
  // plays fresh, every time the menu opens, with no reflow/restart hacks.
  function playEntrance() {
    menuItems.forEach((el) => {
      el.getAnimations().forEach((anim) => anim.cancel());
      el.classList.remove('is-settled');
      const delay = Number(el.dataset.delay) || 0;
      const opacityAnim = el.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 575,
        delay,
        easing: 'ease-out',
        fill: 'forwards',
      });
      const translateAnim = el.animate([{ translate: '0 24px' }, { translate: '0 0' }], {
        duration: 575,
        delay,
        easing: 'cubic-bezier(0.22, 1.36, 0.36, 1)',
        fill: 'forwards',
      });
      // Once the entrance settles, cancel the WAAPI animations (which would
      // otherwise keep pinning `translate` via fill:forwards) and apply the
      // same resting state via a plain CSS class, so nothing is left
      // fighting a future translate change on this element.
      Promise.all([opacityAnim.finished, translateAnim.finished])
        .then(() => {
          opacityAnim.cancel();
          translateAnim.cancel();
          el.classList.add('is-settled');
        })
        .catch(() => {});
    });
  }

  if (bar && overlay) {
    const observer = new MutationObserver(() => {
      const isOpen = bar.dataset.open === 'true';
      overlay.toggleAttribute('inert', !isOpen);
      if (isOpen) playEntrance();
    });
    observer.observe(bar, { attributes: true, attributeFilter: ['data-open'] });
  }

  const copyButtons = overlay ? overlay.querySelectorAll<HTMLButtonElement>('[data-copy-email]') : [];

  copyButtons.forEach((copyButton) => {
    const copyLabel = copyButton.querySelector<HTMLElement>('[data-copy-email-label]');

    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      if (!copyLabel) return;
      const original = copyLabel.textContent;
      try {
        await navigator.clipboard.writeText(email);
        copyLabel.textContent = 'Copied!';
      } catch (err) {
        // Surfaced instead of silently swallowed (e.g. blocked clipboard
        // permission, insecure context) — otherwise a failure here looked
        // identical to success: the button just did nothing either way.
        console.error('Copy email to clipboard failed:', err);
        copyLabel.textContent = "Couldn't copy";
      }
      setTimeout(() => {
        copyLabel.textContent = original;
      }, 1500);
    });
  });

  // Press/release overshoot for every menu link (page links and contact
  // links alike, since they share this class) — quick firm press-in via
  // the CSS transition on .is-pressed, then a springy overshoot-past-rest
  // on release driven by WAAPI so it can go past scale(1) before settling.
  // Same shallow amounts as the reel trigger/footer buttons (see the CSS
  // comment above), animating the standalone `scale` property rather than
  // `transform` to match how this component already treats `translate` as
  // its own independent property elsewhere (the entrance animation).
  const menuLinks = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>('.menu-link')) : [];

  menuLinks.forEach((link) => {
    let settleAnim: Animation | null = null;

    link.addEventListener('pointerdown', () => {
      settleAnim?.cancel();
      link.classList.remove('is-settling');
      link.classList.add('is-pressed');
    });

    const releasePress = () => {
      if (!link.classList.contains('is-pressed')) return;
      settleAnim = link.animate(
        [
          { scale: 0.95 },
          { scale: 1.04, offset: 0.55 },
          { scale: 0.99, offset: 0.8 },
          { scale: 1 },
        ],
        { duration: 380, easing: 'ease-out', fill: 'forwards' }
      );
      link.classList.add('is-settling');
      link.classList.remove('is-pressed');

      const anim = settleAnim;
      anim.finished
        .then(() => {
          anim.cancel();
          link.classList.remove('is-settling');
        })
        .catch(() => {});
    };

    link.addEventListener('pointerup', releasePress);
    link.addEventListener('pointerleave', releasePress);
    link.addEventListener('pointercancel', releasePress);
  });
</script>
