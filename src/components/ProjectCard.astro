---
import type { ProjectCardData } from '../types/project';
import CategoryTag from './CategoryTag.astro';

interface Props {
  project: ProjectCardData;
  /**
   * Home shows bare images only (no caption); Work shows the full card with
   * title/detail/tags. See CaseStudy-Card (Work) vs ProjectCard_Image (Home) in Figma.
   */
  showCaption?: boolean;
  /**
   * 'scroll' (Home) = fixed --col-4 width, tilts in 3D toward the cursor on
   * hover (see ProjectGallery.astro's script). 'grid' (Work) = the row fills
   * the full page width via CSS Grid, so every card's width is
   * track-determined, not a fixed --col-4 — no tilt there; the media zooms
   * in slightly on hover instead (see mediaClass below).
   */
  layout?: 'scroll' | 'grid';
  /** Position within the row — drives the automatic 4:5/7:8 alternation below. */
  index?: number;
}

const { project, showCaption = true, layout = 'scroll', index = 0 } = Astro.props;
// In 'scroll' layout the card's width IS --col-4 (fixed, never grows to fill
// leftover space), so height computed from that same token via a fixed
// ratio stays correct even while the hover interaction widens the card —
// unlike `aspect-ratio`, which would recompute against the box's own live
// width and grow the row taller as it widens.
//
// In 'grid' layout the card's rendered width is whatever its grid track
// ends up (.col-grid's 1fr columns fill the row, so it's often somewhat
// wider than raw --col-4) — a fixed height computed from --col-4
// alone would no longer match that actual width, stretching the image out
// of proportion. `aspect-ratio` recomputing against live width is exactly
// what's wanted there instead (grid cards never widen on hover, so there's
// no "grows taller mid-hover" risk to avoid).
//
// Portrait/Portrait alternation is a Home-only device for visual rhythm in
// the bare-image row — driven automatically by position (odd index = the
// shorter 7:8) rather than a manual per-project field, so editors don't have
// to think about it and the rhythm can't drift out of alternation as
// projects get added/reordered/featured. 7:8 sits between square and 4:5 —
// enough contrast to read as a deliberate rhythm without the starker square
// crop tried first. The Work grid (showCaption) always uses the taller 4:5
// ratio — position never affects Work sizing, so every card there lines up
// in a clean grid. (Previously exact Figma pixel ratios — 523/700 and
// 523/610 — rounded to clean 4:5/7:8 fractions instead.)
const heightRatio = showCaption ? 5 / 4 : index % 2 === 1 ? 8 / 7 : 5 / 4;
const mediaStyle = layout === 'grid' ? `aspect-ratio:${1 / heightRatio}` : `height:calc(var(--col-4) * ${heightRatio})`;
// 'scroll' (Home) cards get the 3D tilt instead (see ProjectGallery.astro's
// script) — the inner image zoom stacked awkwardly on top of that (two
// competing hover effects on the same card), so it's scoped to 'grid'
// (Work) only, which has no tilt of its own.
const mediaClass =
  layout === 'grid'
    ? 'h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
    : 'h-full w-full object-cover';
---

<div
  class="project-card reveal-item group flex flex-col items-start gap-vertical-s"
  data-layout={layout}
  data-category-slugs={project.categories.map((category) => category.slug).join(',')}
  data-coming-soon={project.comingSoon ? '' : undefined}
>
  <Fragment>
    {project.comingSoon ? (
      <div class="contents">
        <div class="relative w-full overflow-hidden rounded-card" style={mediaStyle}>
          {project.media?.type === 'video' ? (
            <video
              src={project.media.url}
              poster={project.media.posterUrl}
              class="h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
            />
          ) : (
            project.media && <img src={project.media.url} alt={project.media.alt} class="h-full w-full object-cover" loading="eager" />
          )}
          <div class="absolute inset-0 flex items-center justify-center bg-[#29282d]/70">
            <p class="font-body text-body-2 text-front">Coming soon</p>
          </div>
        </div>

        {showCaption && (
          <div class="flex w-full flex-col items-start gap-[10px]">
            <h3 class="font-heading text-h3 text-front">{project.title}</h3>
            <p class="font-body text-body-3 text-grey-300">{project.detail}</p>
          </div>
        )}
      </div>
    ) : (
      <a href={project.href} class="contents">
        <div class="w-full overflow-hidden rounded-card" style={mediaStyle}>
          {project.media?.type === 'video' ? (
            <video
              src={project.media.url}
              poster={project.media.posterUrl}
              class={mediaClass}
              autoplay
              muted
              loop
              playsinline
            />
          ) : (
            project.media && <img src={project.media.url} alt={project.media.alt} class={mediaClass} loading="eager" />
          )}
        </div>

        {showCaption && (
          <div class="flex w-full flex-col items-start gap-[10px]">
            <h3 class="font-heading text-h3 text-front">{project.title}</h3>
            <p class="font-body text-body-3 text-grey-300">{project.detail}</p>
          </div>
        )}
      </a>
    )}
  </Fragment>

  {showCaption && (
    <div class="mt-[5px] flex flex-wrap items-center gap-horizontal-xs">
      {project.categories.slice(0, 3).map((category) => <CategoryTag label={category} />)}
    </div>
  )}
</div>

<style>
  /* 'scroll' (Home): fixed --col-4 width. Used to widen on hover and shunt
     later siblings along the strip (a real flex-basis change, FLIP-animated)
     — replaced with a 3D tilt (see ProjectGallery.astro's script) because
     moving any card's actual width/position at all kept reintroducing jerk
     on fast mouse-off, even after fixing the underlying FLIP
     measure-before-cancel bug. A tilt only ever touches the hovered card's
     own transform, so there's no layout left to jerk. 'grid' (Work) is
     sized by its CSS Grid track instead (set on .project-grid in
     ProjectGallery.astro), and doesn't get the tilt — scoped to 'scroll'
     only, same as before.
  */
  .project-card[data-layout='scroll'] {
    flex-shrink: 0;
    width: var(--col-4);
    transform-origin: center;
  }

  /* Same press-tilt treatment as the nav pill's Menu button (right edge
     back/down, left edge up), just triggered by hover instead of a
     pointerdown/pointerup press. Entering is a quick firm tilt-in via this
     CSS transition; the swing back out on mouseoff is WAAPI-driven (see
     ProjectGallery.astro's script) so it can overshoot past 0deg before
     settling, rather than easing straight back to flat. */
  .project-card[data-layout='scroll'].is-tilted {
    transform: perspective(900px) rotateY(7deg);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .project-card[data-layout='scroll'].is-settling {
    transition: none;
  }
</style>
