---
import { fetchAbout } from '../lib/sanity/queries';
import ImageCarousel from './ImageCarousel.astro';

const about = await fetchAbout();

const introLabel = about?.introLabel ?? 'Who we are.';
const introLabelMuted = about?.introLabelMuted ?? 'Built to change your world.';
const introHeading =
  about?.introHeading ??
  "We're a strategic branding studio built to help you understand now and make what's coming next. Creative expertise and guidance for people looking to build and change things, for good.";
const introImages = about?.introImages ?? [];

const approachLabel = about?.approachLabel ?? 'Our approach';
const approachHeading = about?.approachHeading ?? 'Who you are, amplified by strategic craft.';
const approachCards = about?.approachCards ?? [];

const clientsLabel = about?.clientsLabel ?? 'Client experience';
const clients = about?.clients ?? [];
---

<section class="flex flex-col gap-vertical-l px-[var(--page-margin)] pt-vertical-xl" data-reveal-group="about-intro">
  <div class="flex w-full flex-col items-start gap-vertical-s">
    <p class="reveal-item font-tag text-detail text-grey-300">
      {introLabel} <span class="text-services">{introLabelMuted}</span>
    </p>
    <h1 class="reveal-item w-full font-display text-h2 text-front">{introHeading}</h1>
  </div>

  <ImageCarousel images={introImages} />
</section>

<section class="flex flex-col gap-vertical-l px-[var(--page-margin)] pt-vertical-xl" data-reveal-group="about-approach">
  <div class="flex w-full flex-col items-start gap-vertical-s">
    <p class="reveal-item font-tag text-detail text-grey-300">{approachLabel}</p>
    <h2 class="reveal-item w-full font-display text-h2 text-front">{approachHeading}</h2>
  </div>

  <div class="approach-row full-bleed-scroll w-full gap-gutter">
    {approachCards.map((card) => (
      <div class="approach-card reveal-item flex flex-col items-start gap-[16px]">
        <div class="aspect-[523/700] w-full overflow-hidden rounded-card">
          <img src={card.imageUrl} alt={card.imageAlt} class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="approach-copy flex w-full items-start gap-gutter">
          <h3 class="approach-title font-heading text-h3 text-accent-yellow">{card.title}</h3>
          <p class="approach-text font-body text-body-3 text-front">{card.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<slot name="services" />

<style>
  /*
   * Below desktop, the cards become a swipeable horizontal carousel
   * (scroll-snap, no JS needed) — each card gets a fixed column width so it
   * scrolls as a discrete unit, and every card's image ends up the same
   * height since they all share that width (aspect-ratio does the rest).
   *
   * At desktop the row switches to a literal repeat(3, 1fr), matching
   * global.css's own note on why (search "Approach cards' desktop-only
   * grid" there) — this was briefly `repeat(auto-fill, minmax(var(--col-4),
   * 1fr))` instead, which is exactly the failure mode that comment warns
   * .col-grid itself avoids: --col-4 is constant across the WHOLE 1200–
   * 1919px range, so at the narrower end of it auto-fill could only fit 2
   * columns, and that row's 1fr tracks then claimed all the leftover width
   * each — badly oversized cards, reported directly as "the approach cards
   * go to two in a row on certain screen sizes." repeat(3, 1fr) has no such
   * failure mode: 3 columns always divide the row evenly regardless of
   * viewport width within this tier. A card count that isn't a multiple of
   * 3 just leaves a normally-proportioned partial last row (not stretched,
   * not broken) — completely standard grid behaviour, not something that
   * needed solving.
   *
   * Full-bleed break-out + scroll-padding-inline scroll mechanics come from
   * the shared .full-bleed-scroll class (see global.css) — this block only
   * has the approach-row-specific scroll-snap, display mode, and card sizing.
   */
  .approach-row {
    display: flex;
    align-items: flex-start;
    scroll-snap-type: x mandatory;
  }
  .approach-card {
    flex-shrink: 0;
    width: var(--col-4);
    scroll-snap-align: start;
  }
  @media (min-width: 1200px) {
    .approach-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
      scroll-snap-type: none;
    }
    .approach-card {
      width: auto;
    }
  }

  /*
   * Title+text row: stacked (full card width each) below desktop so the
   * title has as much room as possible to stay on one line; side-by-side
   * from 1440px up, where cards are wide enough for both to sit together.
   * The title never wraps mid-word on its own (white-space: nowrap) — at
   * desktop it takes its natural width and the text absorbs the rest; if a
   * card is ever too narrow for that even when stacked (e.g. some portrait
   * tablet widths), the title is allowed to wrap there rather than overflow.
   */
  .approach-copy {
    flex-direction: column;
  }
  .approach-text {
    width: 100%;
  }
  @media (min-width: 1200px) {
    .approach-copy {
      flex-direction: row;
    }
    .approach-title {
      flex-shrink: 0;
      white-space: nowrap;
    }
    .approach-text {
      width: auto;
      min-width: 0;
      flex: 1 1 0%;
    }
  }

  /* Resting/active states for the scroll-driven client-name highlight (see
     script) — a plain color transition, not opacity, so a name reads as
     "lighting up" rather than fading in/out of existence. */
  .client-name {
    color: #5c5c5c;
    transition: color 300ms ease-out;
  }
  .client-name--active {
    color: var(--color-front);
  }
</style>

<section class="flex flex-col gap-vertical-s px-[var(--page-margin)] pt-vertical-xl" data-reveal-group="about-clients">
  <p class="reveal-item font-tag text-detail text-grey-300">{clientsLabel}</p>
  {/* Each name its own span (not the old single joined-string <p>) so JS
      can highlight them individually as a "reading line" sweeps down the
      viewport on scroll (see the script) — separators are plain text
      between spans, not part of any name's own highlight state. */}
  <p class="reveal-item w-full font-heading text-h3">
    {clients.map((name, i) => (
      <>
        <span class="client-name" data-client-name>{name}</span>
        {i < clients.length - 1 && ' • '}
      </>
    ))}
  </p>
</section>

<script>
  import { initScrollRevealGroup } from '../lib/scrollReveal';

  for (const name of ['about-intro', 'about-approach', 'about-clients']) {
    initScrollRevealGroup(name);
  }

  // Client names light up in sequence as you scroll — driven by a fixed
  // "reading line" partway down the viewport (65%, past the point most
  // reading focus naturally sits) rather than an index-based split of the
  // list: a name's own live position is what decides whether it's been
  // "read" yet, the same geometry-driven philosophy initScrollReveal above
  // uses. That's what makes this correct regardless of how many names wrap
  // onto each line at a given viewport width, and naturally bidirectional —
  // scrolling back up un-highlights names the same way scrolling down lit
  // them, with no separate reverse-case to write.
  const clientNames = Array.from(document.querySelectorAll<HTMLElement>('[data-client-name]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (clientNames.length && !reduceMotion) {
    const READING_LINE_VH = 0.65;

    function updateClientHighlight() {
      const lineY = window.innerHeight * READING_LINE_VH;
      clientNames.forEach((span) => {
        const rect = span.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        span.classList.toggle('client-name--active', center < lineY);
      });
    }

    let clientRafId = 0;
    const onClientScroll = () => {
      if (clientRafId) return;
      clientRafId = requestAnimationFrame(() => {
        updateClientHighlight();
        clientRafId = 0;
      });
    };
    updateClientHighlight();
    window.addEventListener('scroll', onClientScroll, { passive: true });
    window.addEventListener('resize', onClientScroll);
  }

  // Intro image carousel controls — only rendered once a third image makes
  // the row genuinely scrollable (see the markup's conditional). Each click
  // pages by one image's-width-plus-gutter in that direction; disabled
  // (rather than hidden) at either end so the row's actual scroll extent is
  // always visible from the controls' state, not just guessed at.
  const introRow = document.querySelector<HTMLElement>('[data-intro-carousel]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-intro-carousel-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-intro-carousel-next]');

  if (introRow && prevBtn && nextBtn) {
    function step() {
      // The narrow image's own width (first child) plus the row's current
      // gutter — reads the actual layout rather than a guessed constant, so
      // it stays correct across every breakpoint's different column/gutter
      // tokens without needing its own copy of those values.
      const first = introRow!.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(introRow!).columnGap || '0');
      return (first?.getBoundingClientRect().width ?? introRow!.clientWidth) + gap;
    }

    function updateDisabled() {
      if (!introRow) return;
      const maxScroll = introRow.scrollWidth - introRow.clientWidth;
      prevBtn!.disabled = introRow.scrollLeft <= 1;
      nextBtn!.disabled = introRow.scrollLeft >= maxScroll - 1;
    }

    prevBtn.addEventListener('click', () => {
      introRow.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      introRow.scrollBy({ left: step(), behavior: 'smooth' });
    });

    introRow.addEventListener('scroll', updateDisabled, { passive: true });
    window.addEventListener('resize', updateDisabled);
    updateDisabled();

    // Press/release overshoot, same as the nav pill and every other button
    // on the site — quick firm press-in via the CSS transition on
    // .is-pressed, then a springy overshoot-past-rest on release driven by
    // WAAPI so it can go past scale(1) before settling.
    [prevBtn, nextBtn].forEach((btn) => {
      let settleAnim: Animation | null = null;

      btn.addEventListener('pointerdown', () => {
        settleAnim?.cancel();
        btn.classList.remove('is-settling');
        btn.classList.add('is-pressed');
      });

      const releasePress = () => {
        if (!btn.classList.contains('is-pressed')) return;
        settleAnim = btn.animate(
          [
            { transform: 'scale(0.82)' },
            { transform: 'scale(1.12)', offset: 0.55 },
            { transform: 'scale(0.97)', offset: 0.8 },
            { transform: 'scale(1)' },
          ],
          { duration: 380, easing: 'ease-out', fill: 'forwards' }
        );
        btn.classList.add('is-settling');
        btn.classList.remove('is-pressed');

        const anim = settleAnim;
        anim.finished
          .then(() => {
            anim.cancel();
            btn.classList.remove('is-settling');
          })
          .catch(() => {});
      };

      btn.addEventListener('pointerup', releasePress);
      btn.addEventListener('pointerleave', releasePress);
      btn.addEventListener('pointercancel', releasePress);
    });
  }
</script>
