---
interface Props {
  title: string;
  subtitle: string;
  tags: string[];
}

const { title, subtitle, tags } = Astro.props;
---

<div class="flex flex-col gap-[7px] items-start w-[456px]">
  <p class="font-heading text-[43px] leading-none text-white">{title}</p>
  <div class="flex flex-col gap-[21px] items-start w-full">
    <p class="font-body text-[22px] leading-[1.15] text-white">{subtitle}</p>
    <div class="flex gap-[7px] items-center">
      {tags.map((tag) => (
        <div class="backdrop-blur-[15px] border border-solid border-white flex items-center justify-center px-4 py-[7px] rounded-[10px]">
          <p class="font-tag text-[15px] leading-[0.96] text-center text-white tracking-[-0.3px] whitespace-nowrap">
            {tag}
          </p>
        </div>
      ))}
    </div>
  </div>
</div>
