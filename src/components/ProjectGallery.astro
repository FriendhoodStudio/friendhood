---
import type { ProjectCardData } from '../types/project';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: ProjectCardData[];
  /** Home shows bare images only; Work shows the full card with title/detail/tags. */
  showCaption?: boolean;
  /** 'scroll' = horizontal scroll strip (Home); 'grid' = wrapping 3-column grid (Work). */
  layout?: 'scroll' | 'grid';
}

const { projects, showCaption = true, layout = 'scroll' } = Astro.props;
---

{/* [scrollbar-width:none]/[&::-webkit-scrollbar]:hidden below — same
    treatment as the services carousel track: a visible native scrollbar
    under this horizontally-scrolling row reads as a stray UI element,
    not a scroll affordance. */}
{layout === 'scroll' ? (
  <section class="overflow-x-auto overflow-y-hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <div
      data-reveal-group="project-gallery"
      class="flex w-max items-end gap-horizontal-m px-[var(--page-margin)] pt-vertical-l pb-vertical-xl"
    >
      {projects.map((project, index) => (
        <ProjectCard project={project} showCaption={showCaption} layout={layout} index={index} />
      ))}
    </div>
  </section>
) : (
  <div
    data-reveal-group="project-gallery"
    class="project-grid col-grid gap-x-gutter gap-y-vertical-l px-[var(--page-margin)] pt-vertical-m"
  >
    {projects.map((project, index) => (
      <ProjectCard project={project} showCaption={showCaption} layout={layout} index={index} />
    ))}
  </div>
)}

<style>
  /* Column count (1/2/3 across breakpoints) comes from the shared .col-grid
     class in global.css. Filtering the Work grid down to fewer cards than
     fit a row can't shrink the column COUNT (CSS has no way to know how
     many are hidden via display:none vs genuinely absent), so those extra
     columns would otherwise stay 1fr and stretch to claim the leftover
     width the missing cards would've used — [data-filtered] swaps to fixed
     --col-4-width tracks instead, so a narrowed-down set just shows fewer
     cards at their normal size rather than stretching the remaining ones.

     Only from 768px up, where that's an actual risk (2 or 3 columns exist
     to shrink down from). Below that there's only ever 1 column, so a lone
     card is never "avoiding an awkward stretch" — full width IS its normal
     size, filtered or not. Applying the fixed-track override there anyway
     shrunk it to raw --col-4 (360px) instead: correct only at the exact
     390px Figma reference width, and short of the real ~400px+ content
     width on most actual phones (e.g. ~400px on a 430px-wide device),
     visibly shrinking the card the moment a filter was clicked. */
  @media (min-width: 768px) {
    .project-grid[data-filtered] {
      grid-template-columns: repeat(auto-fill, var(--col-4));
    }
  }
</style>

<script>
  import { initScrollRevealGroup } from '../lib/scrollReveal';

  initScrollRevealGroup('project-gallery');

  // Home's horizontal strip: each card tilts in 3D on hover — same
  // perspective+rotateY treatment, angles, and overshoot-on-release as the
  // nav pill's Menu button press (right edge back/down, left edge up),
  // just triggered by pointerenter/pointerleave instead of
  // pointerdown/pointerup. Replaces an earlier widen-and-shunt effect
  // (hovering grew the card and pushed later siblings along via a real
  // flex-basis change, FLIP-animated) that stayed visibly jerky on fast
  // mouse-off even after fixing a measure-before-cancel bug in that FLIP
  // code — any approach that moves a sibling's actual layout position is
  // exposed to that whole class of bug. A tilt never touches layout at
  // all: only the hovered card's own transform changes, so there's
  // nothing for a reflow to jerk.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    document
      .querySelectorAll<HTMLElement>('.project-card[data-layout="scroll"]:not([data-coming-soon])')
      .forEach((card) => {
        let settleAnim: Animation | null = null;

        card.addEventListener('pointerenter', () => {
          settleAnim?.cancel();
          card.classList.remove('is-settling');
          card.classList.add('is-tilted');
        });

        card.addEventListener('pointerleave', () => {
          if (!card.classList.contains('is-tilted')) return;

          settleAnim = card.animate(
            [
              { transform: 'perspective(900px) rotateY(7deg)' },
              { transform: 'perspective(900px) rotateY(-2deg)', offset: 0.55 },
              { transform: 'perspective(900px) rotateY(0.6deg)', offset: 0.8 },
              { transform: 'rotateY(0deg)' },
            ],
            { duration: 420, easing: 'ease-out', fill: 'forwards' }
          );
          card.classList.add('is-settling');
          card.classList.remove('is-tilted');

          const anim = settleAnim;
          anim.finished
            .then(() => {
              anim.cancel();
              card.classList.remove('is-settling');
              if (settleAnim === anim) settleAnim = null;
            })
            .catch(() => {});
        });
      });
  }
</script>
