---
import { fetchHero } from '../lib/sanity/queries';

const hero = await fetchHero();

const headline = hero?.headline ?? 'For people thinking about tomorrow.';
const headlineSwapWord = hero?.headlineSwapWord ?? 'people';
const headlineHoverWords = hero?.headlineHoverWords ?? ['places', 'brands', 'orgs'];
const tagline = hero?.tagline ?? 'Create your neighbourhood';
const statement = hero?.statement || 'Get your brand in the hands and hearts of the people that matter most';
const media = hero?.media;
// Optional purpose-shot 4:5 portrait crop of `media`'s video — see the
// heroVideoMobile field description in the Sanity schema. Undefined falls
// back to the existing CSS object-fit crop of the 16:9 source.
const heroVideoMobileUrl = hero?.heroVideoMobileUrl;
// Separate from `media` above (a short muted loop) on purpose — see the
// reelVideo field description in the Sanity schema. The trigger/modal only
// render once this is actually set, rather than falling back to replaying
// the tiny background loop unmuted.
const reelVideoUrl = hero?.reelVideoUrl;
const popUpImages = hero?.popUpImages ?? [];

// Splits the headline around the one literal word that rolls on hover, so
// the rest of the sentence stays put — e.g. "For people thinking about
// tomorrow." with swap word "people" becomes "For " + [people/places/...] +
// " thinking about tomorrow.". Falls back to the plain headline if no swap
// word is set, or it isn't actually present in the headline text.
const swapIndex = headlineSwapWord ? headline.indexOf(headlineSwapWord) : -1;
const headlineBefore = swapIndex >= 0 ? headline.slice(0, swapIndex) : headline;
const headlineAfter = swapIndex >= 0 ? headline.slice(swapIndex + headlineSwapWord.length) : '';
// The swap word itself is included as the first frame, so the resting state
// (before any hover) reads identically to the plain headline. The list is
// duplicated once at the end — see the script below for why.
const hoverWords =
  swapIndex >= 0 && headlineHoverWords.length > 0 ? [headlineSwapWord, ...headlineHoverWords] : [];
const loopWords = hoverWords.length > 0 ? [...hoverWords, hoverWords[0]] : [];
// Each word of the headline as its own piece (spaces kept as plain text
// between them), so the scroll stage can send them flying apart.
const beforeParts = headlineBefore.split(/(\s+)/);
const afterParts = headlineAfter.split(/(\s+)/);
---

{/* pb-vertical-m: the section (and its dark gradient backdrop below, which
    exactly matches this box) previously ended flush with the showreel
    card's own bottom edge — so the card's hard edge and the actual Hero/
    Services section boundary landed on the same pixel, reading as one
    single hard cut rather than two separate, softer things (an image
    ending, and a section changing). A little dark backdrop below the card
    first lets the card's edge sit inside a section, not ON the seam.
    Services' own top padding is reduced by the same amount (see there) so
    the total visible gap before "How we help" doesn't grow. */}
<section class="hero-stage relative" data-hero-section>
  {/* The hero is a pinned scroll "stage": this sticky screen holds still
      for the extra scroll height the section adds (see .hero-stage), while
      the scroll drives the headline and floating images zooming apart past
      the viewer, then the showreel zooming up into focus (the stage script
      below). Once it's through, the page scrolls on normally. */}
  <div class="hero-stage-sticky sticky top-0 flex h-[100dvh] w-full flex-col items-center overflow-hidden px-[var(--page-margin)]">
  {/* Backdrop: the gradient's own colour stops are lifted directly from the
      reference gradient (Figma node 7718:19099) — deep maroon at the top,
      through a dark purple-indigo, down to the page's actual --color-back
      token (not a hardcoded hex) by the bottom of the section, so it blends
      into whatever's below with no visible seam regardless of what that
      token's value is. (A feTurbulence grain layer was tried here too —
      removed after it stayed visibly noticeable while scrolling rather
      than reading as a subtle static texture.) */}
  <div class="hero-backdrop pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <div class="hero-gradient absolute inset-0"></div>
    {/* Experimental — starts fully opaque (a light --color-front cover
        over the normal dark gradient) and fades out as you scroll, see
        the invert script below; sits above the gradient so it hides it
        completely at scroll position 0. */}
    <div class="absolute inset-0 bg-front" data-hero-invert-overlay></div>
  </div>

  {/* Keeps the headline vertically centred in the space below the nav —
      sized from the viewport (see .hero-headline-area), not tied to the
      actual height of the tagline/media below, plus flex centring.
      A flex-1-based version that stretched this block to exactly fill the
      gap up to the tagline's real position was tried first and tuned to
      dead-centre — but the showreel is much taller than one viewport
      (~830px), so "the remaining space before the tagline" collapsed to
      almost nothing and jammed the headline against the nav. Percentage-
      of-viewport sizing is deliberately independent of what's below so it
      can't collapse like that, at the cost of being an approximation
      rather than an exact centre between two measured points. margin-top
      nudges it down slightly for nav clearance. */}
  <div class="hero-headline-area absolute inset-0 flex items-center justify-center px-[var(--page-margin)]">
    {/* Project images that roll up around the headline as the word changes
        — filled in by initHeroPopups (see the script below). In front of
        the headline (z-30 vs its z-20), so an image dragged onto it sits on
        top of the text; resting images are still placed clear of it and of
        each other. Decorative, so hidden from screen readers. */}
    {popUpImages.length > 1 && (
      <Fragment>
        <div class="hero-popup-layer pointer-events-none absolute inset-y-0 z-30" aria-hidden="true" data-hero-popups></div>
        <script type="application/json" data-hero-popup-images set:html={JSON.stringify(popUpImages)} />
      </Fragment>
    )}
    <h1
      class="hero-fade-in hero-headline-shadow hero-headline-heavy-font relative z-20 max-w-[var(--col-8)] text-balance text-center font-display text-h1 text-front pointer-events-none"
    >
      {loopWords.length > 0 ? (
        <Fragment>
          {/* The cycling word sits inside a plain h-[1em] window, same as
              the static headline text's own line box — the Heavy
              weight's top/bottom clipping traced back to the font FILE's
              own declared ascent/descent metrics running well past its
              actual ink, fixed at the font-face level (see the
              ascent-override/descent-override comment in global.css), not
              here. That fix alone wasn't enough to stop next-word
              show-through during the roll's overshoot, though (confirmed on
              real mobile devices even with the overshoot fraction shrunk
              repeatedly) — the actual fix for THAT is the track's own
              gap-[0.15em] (see data-hero-word-track): stacked frames used
              to sit directly flush against each other, so an overshoot
              peeking even slightly past the target frame landed straight on
              the next word's own ink with zero buffer. The gap gives any
              reasonable overshoot real empty space to travel through first
              — see the script's playWordRoll for the matching pixel-based
              (not percentage-based) roll math this requires.
              Separately: the window's WIDTH is set to the exact measured
              advance-width of the current word (see the script below), and
              this font's rounded terminals paint slightly past that advance
              width on the right regardless (confirmed live: a Range over
              the text node measures flush with the window's edge, "govs"/
              "orgs"/etc.'s trailing "s" is still visibly clipped there).
              .hero-word-window-clip's clip-path expands the paint region a
              few px past the window's right edge to cover exactly that —
              deliberately NOT done by padding the window's actual WIDTH
              (tried first): that adds dead space only on the right, making
              the gap to "thinking" visibly bigger than the gap from "For"
              on the left. clip-path is paint-only, so it can't do that.
              Bottom inset is likewise NOT flush (-6px, not 0) — confirmed
              live that "orgs"/"govs" ("g" followed immediately by another
              letter) flat-clip their descender's tail right at the window's
              own 1em box edge otherwise. That box height is a literal
              `1 x font-size` length, unrelated to the font-face's
              ascent-override/descent-override (tried raising
              descent-override first — zero visual effect, since those
              metrics place the baseline within the line box but don't
              change the box's own fixed height that clip-path clips flush
              to). The -6px gives the descender real paint room instead,
              same idea as the right-edge fix above. Widened the track's
              gap-[0.15em] to gap-[0.25em] to compensate — that gap is also
              the roll overshoot's safety margin (see playWordRoll), and
              eating 6px of it here would have reopened the exact
              adjacent-word show-through bug that gap was added to fix. */}
          {beforeParts.map((part) => (/^\s*$/.test(part) ? part : <span class="hero-split">{part}</span>))}<span class="hero-split"><span
            class="hero-word-window-clip relative inline-block h-[1em] align-bottom overflow-visible"
            data-hero-word-window
          ><span class="flex flex-col items-start gap-[0.25em]" data-hero-word-track>
            {/* Only the resting word (frame 0) is real text. The rest paint
                their word via CSS (::before + data-word, see the style
                block) so the H1's actual text content — what Google and
                screen readers read — is just the plain headline, not every
                alternate word run together ("For peopleplacesbrands…").
                Pseudo-element text still contributes to each frame's box,
                so the script's width/height measurements are unaffected. */}
            {loopWords.map((word, i) =>
              i === 0 ? (
                <span class="block h-[1em] whitespace-nowrap leading-none" data-hero-word>{word}</span>
              ) : (
                <span
                  class="block h-[1em] whitespace-nowrap leading-none"
                  data-hero-word
                  data-word={word}
                  aria-hidden="true"
                ></span>
              )
            )}
          </span></span></span><br class="hero-mobile-break" />{afterParts.map((part) => (/^\s*$/.test(part) ? part : <span class="hero-split">{part}</span>))}
        </Fragment>
      ) : (
        headline
      )}
    </h1>
  </div>

  {/* gap reduced from gap-vertical-s to gap-vertical-xs — brings the
      tagline right up close to the showreel below it. */}
    <p class="absolute inset-x-0 bottom-[28px] z-40 text-center font-tag text-detail text-front" data-hero-tagline>
      <span class="hero-tagline-shadow relative z-20 inline-flex items-baseline pointer-events-none">
        {tagline}
        <svg
          class="ml-[0.25em] h-[0.7em] w-auto drop-shadow-[0_1px_8px_rgba(0,0,0,0.7)]"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M9 2.5V15.5M9 15.5L3.5 10M9 15.5L14.5 10"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </p>

    {media && (
      <div
        class="hero-stage-reel absolute z-20 cursor-default overflow-hidden rounded-card"
        data-hero-media
      >
        {media.type === 'video' ? (
          <video
            poster={media.posterUrl}
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
          >
            {/* <source media> is only evaluated once, when the browser first
                runs resource selection — not reactively on resize/rotate,
                same one-time-pick tradeoff as e.g. responsive <picture>
                sources. Acceptable here: the portrait clip suits the tall
                phone-shaped card it lands in on small screens (see
                .hero-stage-reel), and that doesn't need to react live
                either. Listed first: the browser uses the first
                matching <source>, falling through to the plain 16:9 file
                below whenever no mobile-specific clip has been uploaded. */}
            {heroVideoMobileUrl && <source src={heroVideoMobileUrl} media="(max-width: 767px)" />}
            <source src={media.url} />
          </video>
        ) : (
          <img src={media.url} alt={media.alt} class="h-full w-full object-cover" loading="eager" />
        )}

        {/* Deliberately a separate file from the muted loop above (see the
            reelVideo schema field) — wearecollins.com's own reel section
            does the same: a lightweight preview loop plus a distinct
            full-quality asset for the modal, confirmed by inspecting their
            two different Mux playback IDs. Only rendered once that second
            file is actually set. */}
        {reelVideoUrl && (
          <button
            type="button"
            data-reel-trigger
            class="reel-trigger-btn absolute bottom-[var(--page-margin)] left-[var(--page-margin)] cursor-pointer rounded-full border border-front/15 bg-grey-600 px-btn-x py-btn-y font-body text-body-3 text-front backdrop-blur-[14px] transition-colors duration-300 ease-out hover:text-accent-yellow"
          >
            Watch our showreel
          </button>
        )}
      </div>
    )}

    {/* The statement the showreel zooms into at the end of the stage
        (Figma "HeroTitle", node 7552:8892) — starts hidden, zoomed in by
        the stage script. */}
    <div class="pointer-events-none absolute inset-0 z-30 flex items-center justify-center px-[var(--page-margin)]" data-hero-statement>
      <p class="max-w-[var(--col-8)] text-balance text-center font-display text-h1 text-front">{statement}</p>
    </div>
  </div>
</section>

{/* px-0 on mobile (py only) so the video can run edge-to-edge — see the
    video's own comment below for why. sm:p-[24px] restores the original
    symmetric padding once there's enough width that a letterboxed,
    rounded-corner video reads better than a full-bleed one. */}
{reelVideoUrl && (
  <div
    data-reel-overlay
    data-open="false"
    inert
    class="pointer-events-none fixed inset-0 z-[60] flex items-center justify-center bg-back/95 px-0 py-[14px] opacity-0 backdrop-blur-[10px] transition-opacity duration-400 ease-in-out data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 sm:p-[24px]"
  >
    <button
      type="button"
      data-reel-close
      aria-label="Close video"
      class="reel-close-btn absolute right-[14px] top-[14px] flex h-[52px] w-[52px] cursor-pointer items-center justify-center rounded-full border border-front/15 bg-grey-600 backdrop-blur-[14px] transition-[scale] duration-300 ease-out hover:scale-110 sm:right-[24px] sm:top-[24px]"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1 1L17 17M17 1L1 17" stroke="#F9F7F2" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    {/* Full-bleed on mobile — w-full/h-auto (not max-w-full, which only
        caps size against however big the video's own intrinsic dimensions
        already render) so it genuinely stretches to fill the now-
        edge-to-edge overlay width, with square corners to match (rounding
        a corner that's sitting flush against the screen edge reads as a
        mistake, not a design choice). Reverts to the original
        letterboxed-and-rounded treatment from the tablet tier up, where
        the overlay still has real side padding for a rounded corner to
        sit within. */}
    <video
      data-reel-video
      src={reelVideoUrl}
      class="h-auto w-full sm:h-auto sm:max-h-full sm:w-auto sm:max-w-full sm:rounded-card"
      controls
      playsinline
      preload="none"
    />
  </div>
)}

<style>
  /* Greed Extended's licensed Heavy weight, used for just this headline,
     not the rest of the site (see the @font-face comment in global.css for
     why it's a separate family name rather than a font-weight on the
     existing one). Falls back to the Regular weight, then sans-serif, if
     the Heavy file fails to load. */
  .hero-headline-heavy-font {
    font-family: "Greed Extended Heavy", "Greed Extended", sans-serif;
  }

  /* See the markup comment by data-hero-word-window for why this exists —
     expands the window's paint region a few px past its right edge so the
     Heavy weight's rounded terminals aren't clipped there, without
     padding the window's actual layout width (which would visibly unbalance
     the "For [word] thinking" spacing either side). `overflow-visible` on
     the window (see markup) is what gives clip-path room to paint past the
     border box at all — with overflow-hidden the border box clips first
     regardless of what clip-path says. Top/bottom stay flush (0) — that
     axis is already handled by the font-face's ascent/descent-override. */
  .hero-word-window-clip {
    clip-path: inset(0 -8px -6px 0);
  }

  /* Paints the alternate headline words — see the markup comment by
     data-hero-word for why they're CSS content rather than real text. */
  [data-hero-word][data-word]::before {
    content: attr(data-word);
  }

  /* Colour stops derived from the reference gradient (Figma node
     7718:19099) but dialled back well past the original ~25% toward black
     (was #25080c/#100521) — even that read as too present/saturated
     against the rest of the site's much darker, near-black tone. Now
     roughly 60% blended toward --color-back's own #0d0d0d rather than 25%,
     so the maroon/purple reads as a hint of colour low in the mix instead
     of its own distinct band. Fully transparent into --color-back by 100%,
     spanning the section's own full height so the transition to solid
     --color-back genuinely finishes by the bottom edge, not just visually
     trailing off.

     The middle stop's POSITION is a custom property (not a literal `62.5%`
     in the gradient()) so it can be animated — plain custom properties
     can't be interpolated by keyframes, only @property-registered ones
     with a concrete syntax can (same technique as the services glow's
     --glow-angle). Originally animated the gradient's ANGLE instead,
     wobbling it a few degrees either side of straight-down — technically
     running (confirmed via getAnimations()) but practically invisible: a
     small rotation near-vertical barely shifts anything on a section this
     much wider than it is tall. Animating the stop position instead moves
     the actual maroon/purple boundary up and down the section, which is
     visible regardless of aspect ratio since it's a shift along the axis
     the gradient is already running on, not a rotation across it. */
  @property --hero-gradient-stop {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 62.5%;
  }
  /* The radial patch's centre position, orbiting slowly (see
     hero-radial-orbit) — two separately-registered properties rather than
     one, since @property syntax has to describe a single interpolatable
     value and a gradient position is really two independent percentages. */
  @property --hero-radial-x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 20%;
  }
  @property --hero-radial-y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 8%;
  }
  .hero-gradient {
    /* A single top-to-bottom band read as flat/uniform across the width —
       more like a two-tone stripe than an actual gradient MAP. Layering a
       dark radial patch anchored near the top-left (painted first, so it
       sits on top of the linear band beneath it) breaks that up with a
       second tonal zone that varies horizontally too, not just vertically
       — fading to transparent past its own radius so it blends into
       whatever the linear gradient is doing underneath rather than reading
       as a hard-edged shape. */
    background:
      radial-gradient(45% 40% at var(--hero-radial-x) var(--hero-radial-y), var(--color-back) 0%, transparent 65%),
      linear-gradient(to bottom, #170b0d 0%, #0e0a15 var(--hero-gradient-stop), var(--color-back) 100%);
    animation:
      hero-gradient-drift 26s ease-in-out infinite alternate,
      hero-radial-orbit 60s linear infinite;
  }
  @keyframes hero-gradient-drift {
    from {
      --hero-gradient-stop: 50%;
    }
    to {
      --hero-gradient-stop: 78%;
    }
  }
  /* A slow orbit, not a back-and-forth drift like the stop-position
     animation above — `linear` easing and no `alternate`, so it keeps
     circling the same direction rather than reversing. 8 keyframe stops
     approximating a circle (~8%/6% radius, centred around the patch's
     resting position) rather than a true parametric path, since keyframes
     can't compute sin/cos — close enough at this size and speed that the
     faceting isn't visible. */
  @keyframes hero-radial-orbit {
    0% {
      --hero-radial-x: 20%;
      --hero-radial-y: 8%;
    }
    12.5% {
      --hero-radial-x: 17.7%;
      --hero-radial-y: 12.2%;
    }
    25% {
      --hero-radial-x: 12%;
      --hero-radial-y: 14%;
    }
    37.5% {
      --hero-radial-x: 6.3%;
      --hero-radial-y: 12.2%;
    }
    50% {
      --hero-radial-x: 4%;
      --hero-radial-y: 8%;
    }
    62.5% {
      --hero-radial-x: 6.3%;
      --hero-radial-y: 3.8%;
    }
    75% {
      --hero-radial-x: 12%;
      --hero-radial-y: 2%;
    }
    87.5% {
      --hero-radial-x: 17.7%;
      --hero-radial-y: 3.8%;
    }
    100% {
      --hero-radial-x: 20%;
      --hero-radial-y: 8%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-gradient {
      animation: none;
    }
  }

  .hero-tagline-shadow {
    /* Responds to whatever's directly behind it — the gradient, the grain —
       instead of sitting as a flat static colour on top. `difference`
       inverts against the backdrop, which (unlike `overlay`) stays legible
       against our mostly near-black background without needing a brighter
       base colour first; `exclusion` is the same idea with a softer,
       lower-contrast result if this reads as too harsh — a one-word swap
       to try. */
    mix-blend-mode: difference;
  }
  /*
   * Different hover/auto-advance words have different natural widths
   * ("people" vs "orgs"), which on mobile is enough to shift where the
   * headline's natural text-wrap falls — e.g. more of "thinking" fitting
   * onto the first line for a shorter word — visibly shunting the rest of
   * the headline up or down as the word swaps. Forcing a break right after
   * the swap word on mobile only pins the wrap point so it can't move,
   * regardless of which word is showing.
   */
  .hero-mobile-break {
    display: none;
  }
  @media (max-width: 767px) {
    .hero-mobile-break {
      display: block;
    }
  }

  /* The showreel card's native 1670:939 (~16:9) asset ratio, at full mobile
     viewport width, renders as a thin strip with barely any height — fine
     once there's room either side of it (tablet/desktop), too squeezed to
     read as a real hero moment on a narrow phone screen. 4:5 (portrait)
     on mobile only, matching the ratio already used for Work case study
     media elsewhere on the site rather than introducing a one-off. This box
     stays the same regardless of which video source actually loads — when
     no heroVideoMobile clip is uploaded (see above), object-cover crops the
     centre of the 16:9 frame into it; when one is uploaded, a real 4:5
     clip just fills it natively with nothing cropped. */

  /* The pop-up image field runs edge to edge across the screen, past the
     page margins the rest of the hero sits inside. Clipped only
     horizontally (overflow-x: clip, unlike hidden, leaves the vertical
     axis visible) so an image growing at the screen's edge can't cause a
     sideways scroll, while blur still spills softly above and below. */
  .hero-popup-layer {
    left: calc(-1 * var(--page-margin));
    right: calc(-1 * var(--page-margin));
    /* Starts below the nav, so no image sits under the nav pill. */
    top: var(--nav-menu-height);
    overflow-x: clip;
  }

  /* The scroll stage: one screen tall plus the scroll distance the
     transitions play out over (the sticky screen inside holds still for
     that stretch): headline out, showreel in, a beat on the reel, then the
     reel out and the statement in. */
  .hero-stage {
    --hero-stage-scroll: 320vh;
    height: calc(100dvh + var(--hero-stage-scroll));
  }

  /* Headline words, each its own piece so they can fly apart separately. */
  .hero-split {
    display: inline-block;
  }

  /* The showreel's landing size: filling the screen below the nav, inside
     the page margins. It starts hidden, small and blurred in the middle,
     and the stage script zooms it up into this. */
  [data-hero-statement] {
    opacity: 0;
  }

  .hero-stage-reel {
    left: var(--page-margin);
    right: var(--page-margin);
    top: calc(var(--nav-menu-height) + 12px);
    bottom: var(--page-margin);
    opacity: 0;
    pointer-events: none;
  }



  /* Fades the headline in on page load — separate from the scroll-scrubbed
     reveal used everywhere else on the site (scrollReveal.ts), since that's
     calibrated for content scrolling INTO view from below and the Hero is
     already in view at load, so it'd just compute progress=1 immediately
     with no visible animation. A plain load-triggered CSS animation
     instead. Opacity only — animating translate alongside it read as
     jerky, likely fighting the word-cycle span's own width/transform
     animation running inside the same element every frame. */
  .hero-fade-in {
    animation: hero-fade-in 900ms ease-out both;
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in {
      animation: none;
    }
  }

  /* Press/release feel matching the nav pill and every other button on the
     site — quick firm press-in via this CSS transition, then a springy
     overshoot-past-rest on release driven by WAAPI (see script). The
     trigger is a wide text pill (shallower scale, matching the footer
     buttons); the close button is a small round icon button (deeper scale,
     matching the copy-email button's treatment). */
  .reel-trigger-btn.is-pressed {
    transform: scale(0.95);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reel-trigger-btn.is-settling {
    transition: none;
  }
  .reel-close-btn.is-pressed {
    transform: scale(0.82);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reel-close-btn.is-settling {
    transition: none;
  }

  /* Floating project images — created by initHeroPopups, so :global (Astro's
     scoping only reaches elements in this file's own markup). The outer
     .hero-float drifts on a slow loop (direction, distance and speed set per
     image by the script); the inner .hero-popup card is what blurs, fades and
     pops, starting hidden until the script fades it in. */
  :global(.hero-float) {
    position: absolute;
    animation: hero-float-drift var(--drift-duration, 10s) ease-in-out infinite;
  }
  /* Hover-capable devices can pick an image up and drag it about (the
     script only turns pointer events on for them). No text selection or
     native image drag getting in the way, and the cursor says it's
     grabbable. */
  :global(.hero-float) {
    cursor: grab;
    user-select: none;
    touch-action: none;
  }
  :global(.hero-float.is-dragging) {
    cursor: grabbing;
  }
  /* The rounded corners live on the img itself, not as overflow: hidden on
     the card: the card is what gets blurred, and clipping it sliced the
     blur off at the card's edges (very visible on iOS Safari) — leaving
     crisp-edged boxes of fuzz instead of soft shapes. Unclipped, the blur
     feathers out past the image's edges. */
  :global(.hero-popup) {
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  :global(.hero-popup img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  /* A loose loop rather than a straight back-and-forth: out along one axis,
     across, back along the other, with a slight sway — so it reads as
     floating rather than oscillating. */
  @keyframes hero-float-drift {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(var(--drift-x), calc(var(--drift-y) * -0.4)) rotate(var(--drift-rotate));
    }
    50% {
      transform: translate(calc(var(--drift-x) * 0.3), var(--drift-y)) rotate(0deg);
    }
    75% {
      transform: translate(calc(var(--drift-x) * -0.6), calc(var(--drift-y) * 0.3)) rotate(calc(var(--drift-rotate) * -1));
    }
  }
</style>

<script>
  import { lockBodyScroll, unlockBodyScroll } from '../lib/scrollLock';
  import { initHeroPopups } from '../lib/heroPopups';
  import type { HeroPopUpImage } from '../types/hero';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  // Set once the floating images are running (see the word cycle below), so
  // the stage can send them flying past too.
  let popups: ReturnType<typeof initHeroPopups> = null;
  // True while the scroll stage's transition is under way: the headline's
  // word cycle holds still, since a new word's width can re-wrap the lines
  // and send a word to the other line (and the other direction) mid-split.
  let stageUnderway = false;

  // The scroll stage. While the hero's sticky screen is pinned, scroll
  // progress (0 → 1 across the stage's extra height) drives two overlapping
  // phases:
  //   - out (first half): the headline's lines part — top up, bottom down —
  //     racing off screen while the floating images behind drift outward
  //     more slowly (parallax), blurring and fading; the tagline fades
  //     first, and the light backdrop gives way to the dark one;
  //   - in: the showreel zooms up from small and blurred in the middle to
  //     fill the screen, coming into focus, and holds for a beat;
  //   - on: the reel carries on zooming past the viewer, blurring and
  //     fading, as the statement zooms up out of a blur into focus.
  // Scrolling back up plays it in reverse. With reduced motion it's a plain
  // crossfade — no zooming or blur.
  {
    const stage = document.querySelector<HTMLElement>('[data-hero-section]');
    const headline = document.querySelector<HTMLElement>('.hero-headline-shadow');
    const pieces = Array.from(document.querySelectorAll<HTMLElement>('.hero-split'));
    const popupLayer = document.querySelector<HTMLElement>('[data-hero-popups]');
    const tagline = document.querySelector<HTMLElement>('[data-hero-tagline]');
    const reel = document.querySelector<HTMLElement>('[data-hero-media]');
    const statement = document.querySelector<HTMLElement>('[data-hero-statement]');
    const overlay = document.querySelector<HTMLElement>('[data-hero-invert-overlay]');

    // Headline/tagline text goes from the light-theme dark to the normal
    // light as the backdrop darkens — read from the live colour tokens.
    function tokenRgb(name: string) {
      const probe = document.createElement('span');
      probe.style.color = `var(${name})`;
      document.body.appendChild(probe);
      const [r, g, b] = getComputedStyle(probe).color.match(/\d+/g)!.map(Number);
      probe.remove();
      return { r, g, b };
    }
    const dark = tokenRgb('--color-back');
    const light = tokenRgb('--color-front');
    const mix = (t: number) =>
      `rgb(${Math.round(dark.r + (light.r - dark.r) * t)}, ${Math.round(dark.g + (light.g - dark.g) * t)}, ${Math.round(dark.b + (light.b - dark.b) * t)})`;

    // How far the headline's lines travel up/down over the transition, as a
    // share of the screen's height — enough to carry them off screen.
    const LINE_TRAVEL = 0.75;
    // Stage timeline (shares of its scroll): the reel has fully landed by
    // REEL_LANDED_AT, holds for a beat, starts zooming on past at
    // REEL_LEAVES_AT, and the statement comes up from STATEMENT_ARRIVES_AT.
    const REEL_LANDED_AT = 0.56;
    const REEL_LEAVES_AT = 0.66;
    const STATEMENT_ARRIVES_AT = 0.72;
    // How strongly the reel stays on behind the statement, and how far into
    // the normal scroll afterwards (as a share of the screen) it's all faded.
    const REEL_BACKDROP_OPACITY = 0.45;
    const AFTER_FADE = 0.5;
    // How much the headline grows as it passes the viewer.
    const LINE_GROW = 1.6;
    // On phones, where it zooms as one block instead — kept gentle, as the
    // narrow screen fills up fast.
    const BLOCK_GROW = 1.1;
    // Line index of each headline word, for the split (see updateStage).
    let pieceLines: number[] = [];
    const easeIn = (t: number) => t * t;
    const easeOut = (t: number) => 1 - (1 - t) * (1 - t);

    function updateStage() {
      if (!stage) return;
      const travel = stage.offsetHeight - window.innerHeight;
      const p = travel > 0 ? clamp(-stage.getBoundingClientRect().top / travel, 0, 1) : 0;
      // Phases, as shares of the stage: headline out and reel in over the
      // first part (q), a beat on the landed reel, then the reel zooming on
      // past while the statement zooms up into focus.
      const q = clamp(p / REEL_LANDED_AT, 0, 1);
      const out = easeIn(clamp(q / 0.5, 0, 1));
      const into = easeOut(clamp((q - 0.4) / 0.6, 0, 1));
      const darken = clamp((q - 0.15) / 0.3, 0, 1);
      const reelOut = easeIn(clamp((p - REEL_LEAVES_AT) / (1 - REEL_LEAVES_AT - 0.04), 0, 1));
      // Fully in a little before the stage ends, so it rests there in focus.
      const statementIn = easeOut(clamp((p - STATEMENT_ARRIVES_AT) / (0.95 - STATEMENT_ARRIVES_AT), 0, 1));
      // Once the stage is through and the page scrolls on, the statement,
      // its tagline and the blurred reel behind them all fade away over
      // the first part of that scroll, so the step down to the next
      // section doesn't read as a big empty gap.
      const scrolledPast = travel > 0 ? -stage.getBoundingClientRect().top - travel : 0;
      const after = clamp(scrolledPast / (window.innerHeight * AFTER_FADE), 0, 1);

      if (overlay) overlay.style.opacity = String(1 - darken);
      if (headline) headline.style.color = mix(darken);
      if (tagline) {
        tagline.style.color = mix(darken);
        // Fades at the start, and comes back under the statement.
        tagline.style.opacity = String(Math.max(1 - clamp(q / 0.12, 0, 1), statementIn) * (1 - after));
      }
      const wasUnderway = stageUnderway;
      stageUnderway = p > 0.002;
      if (wasUnderway && !stageUnderway) window.dispatchEvent(new Event('hero-stage-rest'));
      popups?.setPaused(p > 0.02);

      if (reel) {
        // It doesn't vanish as it zooms past: it settles back as a dimmed,
        // blurred, still-playing backdrop behind the statement.
        reel.style.opacity = String(clamp(into * 1.6, 0, 1) * (1 - reelOut * (1 - REEL_BACKDROP_OPACITY)) * (1 - after));
        // Only clickable (the "Watch our showreel" button) while it's landed.
        reel.style.pointerEvents = into > 0.95 && reelOut < 0.05 ? 'auto' : 'none';
      }
      if (statement) statement.style.opacity = String(statementIn * (1 - after));

      if (reduceMotion) {
        if (headline) headline.style.opacity = String(1 - out);
        if (popupLayer) popupLayer.style.opacity = String(1 - out);
        return;
      }

      // The headline's lines part like a curtain: lines above its middle
      // slide up and off the top, lines below slide down and off the
      // bottom (a middle line, when it wraps to three on phones, just
      // fades). They travel much further and faster than the floating
      // images (see zoomPast), and that parallax is what makes the title
      // read as sitting in front of them. Lines are found from layout
      // (offsetTop within the headline), which the transforms don't affect.
      if (headline) {
        // In front of the floating images while it parts (they normally sit
        // in front, so a dragged image can cover it) — the title passing
        // over them is what sells the depth.
        headline.style.zIndex = out ? '40' : '';
        // Which line each word is on — worked out only while the headline
        // is at rest, then held for the whole transition, so nothing can
        // regroup mid-scroll. Read in reading order: a new line starts
        // wherever a word begins further left than the one before it (how
        // wrapping looks), or clearly lower down. Positions alone weren't
        // enough — the cycling word's window sits a little lower than the
        // plain words, and got treated as a line of its own.
        if (!out || !pieceLines.length) {
          pieceLines = [];
          let line = 0;
          pieces.forEach((piece, i) => {
            const prev = pieces[i - 1];
            if (prev && (piece.offsetLeft < prev.offsetLeft || piece.offsetTop > prev.offsetTop + prev.offsetHeight * 0.75)) line++;
            pieceLines.push(line);
          });
        }
        const lineCount = pieceLines[pieceLines.length - 1] + 1;
        const middle = (lineCount - 1) / 2;
        const travel = window.innerHeight * LINE_TRAVEL;
        // On phones the headline doesn't split — it stays one block and
        // zooms towards the viewer as a whole.
        const asBlock = window.innerWidth < 768;
        const grow = asBlock ? BLOCK_GROW : LINE_GROW;
        for (const [i, piece] of pieces.entries()) {
          const side = asBlock ? 0 : Math.sign(pieceLines[i] - middle);
          if (!out) {
            piece.style.translate = '';
            piece.style.scale = '';
            piece.style.filter = '';
            piece.style.opacity = '';
            continue;
          }
          // Every word grows around the same point — the headline's centre —
          // rather than its own, so the whole headline scales up towards
          // the viewer with its spacing intact (scaling each word around
          // itself squashed neighbours together).
          piece.style.transformOrigin = `${headline.offsetWidth / 2 - piece.offsetLeft}px ${headline.offsetHeight / 2 - piece.offsetTop}px`;
          piece.style.scale = String(1 + out * grow);
          piece.style.translate = `0 ${side * out * travel}px`;
          piece.style.filter = `blur(${out * 8}px)`;
          // Moving lines stay solid until they're mostly off screen; a
          // middle line has nowhere to go, so it fades sooner.
          // As one block on phones it clears quickly, before it's grown
          // big enough to sprawl across the narrow screen.
          piece.style.opacity = String(
            asBlock ? 1 - clamp(out / 0.55, 0, 1) : side ? 1 - clamp((out - 0.5) / 0.5, 0, 1) : 1 - out
          );
        }
      }
      popups?.zoomPast(out);

      // The reel zooms up from small and blurred to fill the screen, then
      // carries on growing past the viewer — blurring and fading — as the
      // statement zooms up out of a blur into focus behind it.
      if (reel) {
        reel.style.scale = String((0.25 + 0.75 * into) * (1 + reelOut * 0.6));
        const blur = (1 - into) * 30 + reelOut * 24;
        reel.style.filter = blur > 0.1 ? `blur(${blur}px)` : '';
      }
      if (statement) {
        statement.style.scale = String(0.7 + 0.3 * statementIn);
        statement.style.filter = statementIn < 1 ? `blur(${(1 - statementIn) * 20}px)` : '';
      }
    }

    if (stage) {
      let rafId = 0;
      const onScroll = () => {
        if (rafId) return;
        rafId = requestAnimationFrame(() => {
          rafId = 0;
          updateStage();
        });
      };
      updateStage();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }
  }

  // Headline hover word: each mouseenter rolls the track up by one word
  // (same fixed-height-window + translateY technique as the nav's Menu/Close
  // toggle). The word list is rendered with the first word duplicated at the
  // end, so the roll can always move in the same direction — on landing on
  // that duplicate, it's visually identical to the real first word, so the
  // track jumps back to index 0 with transitions off for one frame, which
  // reads as a seamless loop rather than a snap backwards.
  const wordWindow = document.querySelector<HTMLElement>('[data-hero-word-window]');
  const wordTrack = document.querySelector<HTMLElement>('[data-hero-word-track]');

  if (wordWindow && wordTrack && !reduceMotion) {
    // Rebind to non-null locals: TS narrowing from the outer if-check
    // doesn't persist into the advance() closure defined below.
    const win = wordWindow;
    const track = wordTrack;

    const popupLayer = document.querySelector<HTMLElement>('[data-hero-popups]');
    const popupData = document.querySelector<HTMLScriptElement>('[data-hero-popup-images]');
    const popupHeadline = document.querySelector<HTMLElement>('.hero-headline-shadow');
    popups =
      popupLayer && popupData && popupHeadline
        ? initHeroPopups(
            popupLayer,
            popupHeadline,
            JSON.parse(popupData.textContent || '[]') as HeroPopUpImage[],
            // The track's last frame is a duplicate of the first (for the
            // seamless loop), so it isn't a word of its own.
            track.children.length - 1
          )
        : null;
    const frameCount = track.children.length;
    let index = 0;

    // Pixel step (one frame's own height + the gap-[0.15em] after it — see
    // the markup comment), not a percentage of the track's total height —
    // percentage-based translateY was exactly what made the roll's
    // overshoot show adjacent-word ink on mobile: with zero space reserved
    // between stacked frames, ANY overshoot past the target frame's own
    // position landed straight on the next frame's real content, no matter
    // how small the overshoot fraction. Frame height (not width) is uniform
    // across every word — all frames share the same font-size/line-height,
    // only their WIDTH differs — so a single measured step covers all of
    // them, re-measured on resize/font-load same as frameWidths below since
    // both em-based values (the h-[1em] frame and the gap-[0.15em]) scale
    // with font-size across breakpoints.
    // The window's true (unscaled) size. While the scroll stage has the
    // headline scaled up, getBoundingClientRect reports the enlarged size —
    // measuring then (on a resize or late font load) used to leave the roll
    // step and window width wrong once the headline was back at rest: the
    // word sat too high, clipped, in a too-wide slot. Dividing out the
    // stage's scale on the word's piece keeps every measurement true.
    const stageScale = () => parseFloat(win.parentElement?.style.scale || '1') || 1;
    const trueWidth = (el: Element) => el.getBoundingClientRect().width / stageScale();
    const trueHeight = (el: Element) => el.getBoundingClientRect().height / stageScale();

    let frameStep = 0;
    function measureFrameStep() {
      const first = track.children[0] as HTMLElement | undefined;
      if (!first) return;
      const gap = parseFloat(getComputedStyle(track).rowGap) || 0;
      frameStep = trueHeight(first) + gap;
    }
    measureFrameStep();

    // Each word has a different natural width. The window is sized to
    // exactly the word currently showing (not the widest of the set) and
    // transitions width alongside the roll, so the centered/balanced
    // headline reflows around it instead of leaving a gap for shorter words.
    // Widths are in pixels and font-size changes at each responsive
    // breakpoint, so they're re-measured on resize (see below) rather than
    // captured once — otherwise the box keeps its stale desktop/mobile size
    // after the viewport crosses a breakpoint.
    //
    // Deliberately NOT padded to cover the Heavy weight's rounded
    // terminals painting slightly past their own advance-width box on the
    // right (confirmed live: a Range over the text node measures flush with
    // the window's edge, but the "s" in "orgs" was still visibly clipped
    // there). Padding the WIDTH to fix that adds dead space only on the
    // right, which throws off the "For [word] thinking" spacing on either
    // side — the browser reports this measurement correctly, the ink just
    // overshoots it, so the fix belongs on the clip-path (paint-only, see
    // .hero-word-window-clip) rather than here on layout.
    const frames = Array.from(track.children) as HTMLElement[];
    let frameWidths = frames.map((frame) => trueWidth(frame));
    if (frameWidths[0]) win.style.width = `${frameWidths[0]}px`;

    // On a cold cache, this script can run (and take the measurement above)
    // before Greed Extended has finished loading — the window gets sized
    // against the browser's fallback font, then the real font swaps in
    // wider once it arrives, clipping the word against the now-too-narrow
    // box for whatever's left of the current 2.2s interval. Re-measuring
    // once the real fonts are actually ready corrects that; a no-op on a
    // warm cache where they were already loaded before this ran.
    document.fonts.ready.then(() => {
      frameWidths = frames.map((frame) => trueWidth(frame));
      const width = frameWidths[index];
      if (width) win.style.width = `${width}px`;
      measureFrameStep();
    });

    // Roll — replaces an earlier motion-blur treatment on the same roll
    // (tried, then swapped for this instead). WAAPI rather than the CSS
    // `transition-transform` this replaced, so animateWordWidth below (a
    // real overshoot-and-settle, unlike this one — see the no-overshoot
    // comment in playWordRoll) can stay in sync with it via the same
    // Animation-based approach.
    // Fractions of one frameStep, not fixed px — so the excursion scales
    // with the actual measured step (which itself scales with font-size
    // across breakpoints) rather than needing its own per-breakpoint
    // tuning. 0.1 keeps the overshoot's peak excursion (0.1 * frameStep,
    // where frameStep = 1em + the 0.15em gap ≈ 1.15em) at roughly 0.115em
    // past the target — comfortably inside the 0.15em gap with real margin
    // to spare, unlike the old percentage-based version which had zero
    // buffer at all and showed adjacent-word ink at every fraction tried.
    const ROLL_OVERSHOOT_FRACTION = 0.1;
    const ROLL_SETTLE_FRACTION = -0.025;

    let rollAnim: Animation | null = null;
    function playWordRoll(targetPx: number) {
      const startPx = -(index - 1) * frameStep;
      rollAnim?.cancel();
      // Overshoot restored (was cut entirely — see git history/prior
      // session notes — once gap-[0.15em] existed, there was nowhere safe
      // for it to swing into and it showed adjacent-word ink on mobile no
      // matter how small the fraction). The gap now gives it real empty
      // space to travel through first, so the spring reads the same as
      // every other press/release interaction on the site again.
      const delta = targetPx - startPx;
      const overshootPx = targetPx + delta * ROLL_OVERSHOOT_FRACTION;
      const settlePx = targetPx + delta * ROLL_SETTLE_FRACTION;
      rollAnim = track.animate(
        [
          { transform: `translateY(${startPx}px)` },
          { transform: `translateY(${overshootPx}px)`, offset: 0.7 },
          { transform: `translateY(${settlePx}px)`, offset: 0.88 },
          { transform: `translateY(${targetPx}px)` },
        ],
        { duration: 750, easing: 'ease-out', fill: 'forwards' }
      );
      const anim = rollAnim;
      anim.finished
        .then(() => {
          anim.cancel();
          track.style.transform = `translateY(${targetPx}px)`;
          if (rollAnim === anim) rollAnim = null;
          // Once the roll into the final looping-duplicate frame actually
          // completes, reset immediately rather than waiting for the next
          // advance() call — this is what makes the loop look seamless.
          // advance()'s own index self-correction is the fallback for when
          // this doesn't fire (e.g. a backgrounded tab never resolving the
          // finished promise).
          if (index === frameCount - 1) resetToFirstFrame();
        })
        .catch(() => {});
    }

    // Width overshoot-and-settle when the window resizes to fit the new
    // word — same overshoot-and-settle language as the nav pill/footer
    // buttons elsewhere, WAAPI-driven rather than the plain CSS
    // `transition: width` this replaced, so it can express the overshoot at
    // all (a CSS transition can only ease toward the target, never past it).
    // The overshoot/settle amounts scale with the actual width DELTA for
    // this particular word change, not a fixed px offset — a one-letter
    // difference (e.g. "brand" → "orgs") gets a proportionally small
    // overshoot, a much longer/shorter word gets a bigger one, so it always
    // reads as "slightly too far for how far it moved" rather than a fixed
    // wobble that'd look oversized on a small change.
    let widthAnim: Animation | null = null;
    function animateWordWidth(targetWidth: number) {
      // Measure the ACTUAL current width before cancelling any in-flight
      // animation — cancelling first would snap it straight to its old
      // resting width, so a rapid word-to-word change mid-swing would
      // measure "start" as if nothing was moving and jump instead of
      // continuing smoothly. Same bug class fixed elsewhere on this site.
      const startWidth = trueWidth(win);
      widthAnim?.cancel();
      const delta = targetWidth - startWidth;
      // The roll itself no longer overshoots (see the no-overshoot comment
      // in playWordRoll — a clipped window has no room for it), but a
      // width change has nothing to clip against, so it keeps its own
      // spring here same as every other press/release interaction on the
      // site.
      const overshoot = targetWidth + delta * 0.06;
      const settle = targetWidth - delta * 0.02;
      widthAnim = win.animate(
        [
          { width: `${startWidth}px` },
          { width: `${overshoot}px`, offset: 0.6 },
          { width: `${settle}px`, offset: 0.85 },
          { width: `${targetWidth}px` },
        ],
        { duration: 750, easing: 'ease-out', fill: 'forwards' }
      );
      const anim = widthAnim;
      anim.finished
        .then(() => {
          anim.cancel();
          win.style.width = `${targetWidth}px`;
          if (widthAnim === anim) widthAnim = null;
        })
        .catch(() => {});
    }

    function resetToFirstFrame() {
      index = 0;
      // No reflow-forcing dance needed here any more — that was only ever
      // working around the CSS transition this component used to have
      // (zeroing transition-duration so the "instant" jump wasn't itself
      // animated). A plain style assignment with no WAAPI animation
      // targeting it is already instant.
      rollAnim?.cancel();
      rollAnim = null;
      track.style.transform = `translateY(0)`;
    }

    function advance() {
      if (frameCount <= 1 || stageUnderway) return;
      // Self-correcting rather than relying solely on playWordRoll's own
      // finished-promise reset: once we're sitting on (or, from a burst of
      // rapid triggers, ever managed to reach) the final looping-duplicate
      // frame, snap back to the real first frame before continuing. Relying
      // only on that promise resolving was fragile — an interrupted
      // animation (rapid re-triggers, or a backgrounded tab throttling/
      // coalescing the touch-device auto-advance timer so several ticks
      // fire back-to-back once it's foregrounded again) can leave it never
      // resolving, which left index permanently stuck at the last frame
      // with nothing to recover it.
      if (index >= frameCount - 1) resetToFirstFrame();
      index++;
      playWordRoll(-index * frameStep);
      // index lands on the looping duplicate of word 0 once per cycle.
      popups?.showWord(index % (frameCount - 1));
      const width = frameWidths[index];
      if (width) animateWordWidth(width);
    }

    // Auto-advances on a timer on every screen, not just touch/no-hover
    // devices — desktop visitors who never hover the word still see it cycle.
    window.setInterval(advance, 2000);

    let resizeRafId = 0;
    const remeasureWord = () => {
      if (resizeRafId) return;
      resizeRafId = requestAnimationFrame(() => {
        resizeRafId = 0;
        frameWidths = frames.map((frame) => trueWidth(frame));
        const width = frameWidths[index];
        if (width) {
          // Instant, not animated — this is a layout correction for the new
          // viewport/font-size, not a user-triggered roll. Cancels any
          // in-flight overshoot from animateWordWidth first, since that's a
          // WAAPI animation now rather than a CSS transition this could
          // previously suspend by zeroing the transition-duration.
          widthAnim?.cancel();
          widthAnim = null;
          win.style.width = `${width}px`;
        }
        // Same instant-correction reasoning for the vertical position:
        // frameStep is also em-based (both the h-[1em] frame and the
        // gap-[0.15em] scale with font-size), so it's stale after a
        // breakpoint change too — left uncorrected, the track would sit at
        // a pixel offset computed for the OLD font-size and land on the
        // wrong frame, or partway between two.
        measureFrameStep();
        rollAnim?.cancel();
        rollAnim = null;
        track.style.transform = `translateY(${-index * frameStep}px)`;
      });
    };
    window.addEventListener('resize', remeasureWord);
    // And again whenever the scroll stage returns the headline to rest, as
    // a belt-and-braces correction for anything measured mid-transition.
    window.addEventListener('hero-stage-rest', remeasureWord);

  }

  // Reel modal — the background hero video is already the showreel (muted,
  // looping); this opens the same file full-size, unmuted, with native
  // controls. A separate <video> element rather than relocating the
  // existing one, so the background loop keeps playing behind it untouched
  // and there's nothing to move back afterwards.
  const reelTrigger = document.querySelector<HTMLButtonElement>('[data-reel-trigger]');
  const reelOverlay = document.querySelector<HTMLElement>('[data-reel-overlay]');
  const reelClose = document.querySelector<HTMLButtonElement>('[data-reel-close]');
  const reelVideo = document.querySelector<HTMLVideoElement>('[data-reel-video]');

  if (reelTrigger && reelOverlay && reelClose && reelVideo) {
    function openReel() {
      reelOverlay!.dataset.open = 'true';
      reelOverlay!.removeAttribute('inert');
      reelVideo!.muted = false;
      reelVideo!.currentTime = 0;
      reelVideo!.play().catch(() => {});
      lockBodyScroll();
      reelWentFullscreen = false;
      // Covers opening the reel while the phone is already lying landscape
      // (not just tilting into landscape after the fact).
      handleReelOrientationChange();
    }

    function closeReel() {
      reelOverlay!.dataset.open = 'false';
      reelOverlay!.setAttribute('inert', '');
      reelVideo!.pause();
      unlockBodyScroll();
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      const anyVideo = reelVideo as HTMLVideoElement & {
        webkitExitFullscreen?: () => void;
        webkitDisplayingFullscreen?: boolean;
      };
      if (anyVideo.webkitDisplayingFullscreen) anyVideo.webkitExitFullscreen?.();
    }

    reelTrigger.addEventListener('click', openReel);
    reelClose.addEventListener('click', closeReel);
    reelOverlay.addEventListener('click', (e) => {
      // Only the backdrop itself, not the video or close button, both of
      // which are also technically within the overlay's own click target.
      if (e.target === reelOverlay) closeReel();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && reelOverlay.dataset.open === 'true') closeReel();
    });

    // Tilting the phone to landscape while the reel is open reads as "make
    // this fullscreen" — the same gesture native video apps (YouTube etc.)
    // already train people on — so mirror it via the Fullscreen API rather
    // than leaving the viewer to find a button. iOS Safari doesn't expose
    // the standard API on <video> the way other browsers do; it has its own
    // native fullscreen video player instead, entered via
    // `webkitEnterFullscreen` and — critically — dismissed by swiping down,
    // which fires `webkitendfullscreen` on the video element rather than
    // the standard `fullscreenchange` event. Either dismissal path (that
    // swipe, the standard API's Escape/back gesture, or its own close
    // control) should read as "leave the reel entirely", not "drop back to
    // the modal underneath" — so both close the whole overlay, not just
    // fullscreen.
    const reelVideoEl = reelVideo as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
    let reelWentFullscreen = false;

    function enterReelFullscreen() {
      if (reelWentFullscreen || reelOverlay!.dataset.open !== 'true') return;
      if (document.fullscreenElement || (document as unknown as { webkitFullscreenElement?: unknown }).webkitFullscreenElement) return;
      reelWentFullscreen = true;
      if (reelVideoEl.requestFullscreen) {
        reelVideoEl.requestFullscreen().catch(() => {
          reelWentFullscreen = false;
        });
      } else if (reelVideoEl.webkitEnterFullscreen) {
        reelVideoEl.webkitEnterFullscreen();
      } else {
        reelWentFullscreen = false;
      }
    }

    function handleReelOrientationChange() {
      if (!window.matchMedia('(max-width: 767px)').matches) return;
      if (window.matchMedia('(orientation: landscape)').matches) {
        enterReelFullscreen();
      }
    }

    reelVideoEl.addEventListener('webkitendfullscreen', () => {
      reelWentFullscreen = false;
      if (reelOverlay!.dataset.open === 'true') closeReel();
    });
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        const wasAutoFullscreen = reelWentFullscreen;
        reelWentFullscreen = false;
        if (wasAutoFullscreen && reelOverlay!.dataset.open === 'true') closeReel();
      }
    });
    window.matchMedia('(orientation: landscape)').addEventListener('change', handleReelOrientationChange);

    // Same press/release overshoot as the nav pill, footer buttons, and the
    // services card's copy-email button — quick press-in via the CSS
    // transition on .is-pressed, then a springy overshoot-past-rest on
    // release driven by WAAPI so it can go past scale(1) before settling.
    function applyPressOvershoot(el: HTMLElement, pressScale: number, overshootScale: number, settleScale: number) {
      let settleAnim: Animation | null = null;

      el.addEventListener('pointerdown', () => {
        settleAnim?.cancel();
        el.classList.remove('is-settling');
        el.classList.add('is-pressed');
      });

      const releasePress = () => {
        if (!el.classList.contains('is-pressed')) return;
        settleAnim = el.animate(
          [
            { transform: `scale(${pressScale})` },
            { transform: `scale(${overshootScale})`, offset: 0.55 },
            { transform: `scale(${settleScale})`, offset: 0.8 },
            { transform: 'scale(1)' },
          ],
          { duration: 380, easing: 'ease-out', fill: 'forwards' }
        );
        el.classList.add('is-settling');
        el.classList.remove('is-pressed');

        const anim = settleAnim;
        anim.finished
          .then(() => {
            anim.cancel();
            el.classList.remove('is-settling');
          })
          .catch(() => {});
      };

      el.addEventListener('pointerup', releasePress);
      el.addEventListener('pointerleave', releasePress);
      el.addEventListener('pointercancel', releasePress);
    }

    applyPressOvershoot(reelTrigger, 0.95, 1.04, 0.99);
    applyPressOvershoot(reelClose, 0.82, 1.12, 0.97);

    // Swipe down to close, mobile/tablet only — same gesture as the
    // case-study Lightbox's own swipe-to-close. Only ever relevant in the
    // reel's normal (non-native-fullscreen) presentation, i.e. its "first
    // state" before any tilt-to-fullscreen or manual native fullscreen
    // engages: once real fullscreen kicks in, the browser's own fullscreen
    // UI replaces this overlay entirely (and already has its own dismiss
    // gesture — see webkitendfullscreen above), so there's nothing here
    // left to swipe on regardless — no explicit "not fullscreen" check
    // needed, it falls out of the DOM/JS simply not being what's on screen
    // at that point.
    //
    // Listens on reelOverlay, not just the video — same reasoning as the
    // Lightbox's own tap-toggle: the close button is a sibling of the
    // video, not a descendant, so a swipe starting on or near it should
    // still work. touch-action is deliberately left at its default (not
    // set to none, unlike the Lightbox's custom stage) since the native
    // <video controls> bar needs its own default touch handling (tap to
    // show/hide controls, drag the scrub bar) to keep working — body
    // scroll is already locked via lockBodyScroll() in openReel(), so
    // there's no native page-scroll for a stray touch to trigger anyway,
    // and e.preventDefault() below only fires once a gesture is already
    // confirmed vertical, past the point where a horizontal scrub-bar drag
    // would have been.
    function isMobileOrTablet() {
      return window.innerWidth < 1200;
    }

    const REEL_SWIPE_CLOSE_THRESHOLD_PX = 100;
    const REEL_SWIPE_CLOSE_VELOCITY_PX_MS = 0.5;

    let reelSwipePointerId: number | null = null;
    let reelSwipeStartX = 0;
    let reelSwipeStartY = 0;
    let reelSwipeStartTime = 0;
    let reelSwipeActive = false;
    let reelSwipeDeltaY = 0;

    reelOverlay.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch' || !isMobileOrTablet()) return;
      reelSwipePointerId = e.pointerId;
      reelSwipeStartX = e.clientX;
      reelSwipeStartY = e.clientY;
      reelSwipeStartTime = e.timeStamp;
      reelSwipeActive = false;
      reelSwipeDeltaY = 0;
    });

    reelOverlay.addEventListener('pointermove', (e) => {
      if (reelSwipePointerId !== e.pointerId) return;
      const dx = e.clientX - reelSwipeStartX;
      const dy = e.clientY - reelSwipeStartY;

      if (!reelSwipeActive) {
        // Wait for enough movement to confidently read direction — locking
        // on the first pixel of jitter would misclassify a real horizontal
        // scrub-bar drag.
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        if (Math.abs(dy) <= Math.abs(dx)) {
          // Horizontal-dominant — leave it entirely to native (the scrub
          // bar, most likely).
          reelSwipePointerId = null;
          return;
        }
        reelSwipeActive = true;
        reelVideo!.setPointerCapture(e.pointerId);
        reelVideo!.style.transition = 'none';
      }

      e.preventDefault();
      reelSwipeDeltaY = Math.max(0, dy); // downward only — an upward drag is a no-op
      reelVideo!.style.translate = `0 ${reelSwipeDeltaY}px`;
      reelVideo!.style.opacity = String(Math.max(0.3, 1 - reelSwipeDeltaY / 400));
    });

    function endReelSwipe(e: PointerEvent) {
      if (reelSwipePointerId !== e.pointerId) return;
      reelSwipePointerId = null;
      if (!reelSwipeActive) return;
      reelSwipeActive = false;
      try {
        reelVideo!.releasePointerCapture(e.pointerId);
      } catch {
        // Already released/invalid — nothing to clean up.
      }

      const elapsed = e.timeStamp - reelSwipeStartTime;
      const velocity = reelSwipeDeltaY / Math.max(elapsed, 1);
      if (reelSwipeDeltaY > REEL_SWIPE_CLOSE_THRESHOLD_PX || velocity > REEL_SWIPE_CLOSE_VELOCITY_PX_MS) {
        closeReel();
        // Reset AFTER the overlay's own close fade (transition-opacity
        // duration-400) finishes, not immediately — resetting right away
        // would visibly snap the video back into place while the overlay
        // is still visible mid-fade.
        window.setTimeout(() => {
          reelVideo!.style.translate = '0';
          reelVideo!.style.opacity = '1';
        }, 400);
      } else {
        // Under threshold — spring back.
        reelVideo!.style.transition = 'translate 300ms ease-out, opacity 300ms ease-out';
        reelVideo!.style.translate = '0';
        reelVideo!.style.opacity = '1';
        window.setTimeout(() => {
          reelVideo!.style.transition = 'none';
        }, 300);
      }
    }

    reelOverlay.addEventListener('pointerup', endReelSwipe);
    reelOverlay.addEventListener('pointercancel', endReelSwipe);
  }
</script>
