---
import logo from '../assets/nav/friendhood-logo.svg';
---

<header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-[var(--page-margin)] py-8">
  <div class="flex items-center rounded-[10px] bg-black/40 px-5 py-[15px] backdrop-blur-[20px]">
    <img src={logo.src} alt="Friendhood" class="h-[30px] w-auto" />
  </div>

  <button
    type="button"
    class="font-tag flex items-center justify-center rounded-[10px] bg-black/50 px-[25px] py-5 text-[19px] leading-[0.96] tracking-[-0.38px] text-[#eeeee9] backdrop-blur-[7px]"
  >
    Menu
  </button>
</header>
